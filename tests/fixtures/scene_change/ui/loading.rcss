body {
    font-family: Open Sans;
    font-size: 16px;
    color: #e8f0ff;
    width: 100%;
    height: 100%;
}

#loading_root {
    display: block;
    width: 640px;
    height: 240px;
    margin: 80px auto;
}

#loading_title {
    display: block;
    height: 44px;
    font-size: 30px;
    text-align: center;
}

#loading_bar {
    display: block;
    width: 460px;
    height: 14px;
    margin: 24px auto;
    background-color: #1b2433;
}

#loading_fill {
    display: block;
    width: 220px;
    height: 14px;
    background-color: #5ce1e6;
}

#loading_progress {
    display: block;
    width: 460px;
    height: 24px;
    margin: 0 auto;
    text-align: center;
}

#loading_label {
    display: block;
    width: 460px;
    height: 20px;
    margin: 8px auto;
    text-align: center;
}
