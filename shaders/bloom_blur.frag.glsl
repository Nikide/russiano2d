#version 450

// ---------------------------------------------------------------------------
// Bloom, шаг 2: размытие по одной оси (разделяемое гауссово).
//
// Два прохода вместо одного двумерного: 5 выборок вместо 25 на пиксель.
// Веса и смещения — «dual filter»: соседние тексели берутся с линейной
// фильтрацией, поэтому одна выборка заменяет две.
//
// Направление приходит юниформой: (1/w, 0) — по горизонтали, (0, 1/h) — по
// вертикали. Сила (z) — общий множитель размаха: ею регулируется «толщина»
// свечения без смены шейдера.
// ---------------------------------------------------------------------------

layout(set = 2, binding = 0) uniform sampler2D u_src;

layout(set = 3, binding = 0) uniform BlurParams {
    vec4 p;   // xy = шаг в UV (направление), z = сила размытия
} u;

layout(location = 0) in vec2 v_uv;
layout(location = 0) out vec4 o_color;

void main()
{
    vec2 uv = vec2(v_uv.x, 1.0 - v_uv.y);
    vec2 step_uv = u.p.xy * max(u.p.z, 0.0);

    vec3 acc = texture(u_src, uv).rgb * 0.2270270270;
    acc += texture(u_src, uv + step_uv * 1.3846153846).rgb * 0.3162162162;
    acc += texture(u_src, uv - step_uv * 1.3846153846).rgb * 0.3162162162;
    acc += texture(u_src, uv + step_uv * 3.2307692308).rgb * 0.0702702703;
    acc += texture(u_src, uv - step_uv * 3.2307692308).rgb * 0.0702702703;

    o_color = vec4(acc, 1.0);
}
