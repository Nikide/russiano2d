#version 450

// ---------------------------------------------------------------------------
// Меш псевдо-3D: одна вершина = 7 float из того же буфера, что у батча
// треугольников (шесть) плюс глубина. Формат совпадает с остальными
// подсистемами, поэтому буфер и индексный буфер общие, а отличается только
// конвейер: он читает седьмой float и пишет настоящую глубину.
//
// Разделять форматы важно: у спрайтов и треугольников z = 0 («ближе всего»),
// и если бы они писали глубину как float4, поменялось бы поведение всей
// отрисовки, а не только меша.
// ---------------------------------------------------------------------------

// Позиция — vec3: глубина лежит третьим компонентом. Отдельный атрибут с
// нулевым смещением пересекался бы с позицией, и конвейер не создавался бы.
layout(location = 0) in vec3 a_position;   // clip-space xy + глубина z
layout(location = 1) in vec2 a_texcoord;
layout(location = 2) in vec4 a_color;      // нормализованные байты

layout(location = 0) out vec2 v_texcoord;
layout(location = 1) out vec4 v_color;

void main()
{
    gl_Position = vec4(a_position, 1.0);
    v_texcoord  = a_texcoord;
    v_color     = a_color;
}
