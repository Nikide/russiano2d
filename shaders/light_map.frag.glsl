#version 450

// ---------------------------------------------------------------------------
// Lightmap: композит накопленного света на сцену.
//
// Свет копится в отдельной текстуре (половинное разрешение, аддитивно — см.
// r2d_render_draw_lights), при желании размывается, а сюда приходит обычной
// текстурой. Конвейер создаётся с аддитивным смешиванием, поэтому шейдер
// просто отдаёт цвет света: сложение делает GPU.
//
// Зачем вообще отдельная текстура. Свет — аддитивные треугольники, и если
// рисовать их прямо в сцену, порядок света начинает зависеть от порядка
// сцены (отсюда и костыль с .punch()). В своей текстуре порядок перестаёт
// иметь значение, а половинное разрешение с линейной фильтрацией само даёт
// мягкую кромку тени.
//
// Раскладка ресурсов SDL_GPU: set 2 — текстура фрагментной стадии,
// set 3 — её юниформы (как в bloom_blur.frag.glsl и post.frag.glsl).
// ---------------------------------------------------------------------------

layout(set = 2, binding = 0) uniform sampler2D u_src;

layout(set = 3, binding = 0) uniform LightMapParams {
    vec4 p;   // x — общая сила света (множитель перед сложением)
} u;

layout(location = 0) in vec2 v_uv;
layout(location = 0) out vec4 o_color;

void main()
{
    // Цели рендера в SDL_GPU читаются перевёрнутыми по Y — так же, как в
    // bloom_blur.frag.glsl.
    vec2 uv = vec2(v_uv.x, 1.0 - v_uv.y);
    float power = max(u.p.x, 0.0);
    o_color = vec4(texture(u_src, uv).rgb * power, 1.0);
}
