#version 450

// ---------------------------------------------------------------------------
// Пост-обработка russiano2d — вершинная стадия.
//
// Полноэкранный треугольник без вершинного буфера: три вершины по
// gl_VertexIndex. Классический приём — прямоугольник [-1,1]² покрывается
// одним треугольником с координатами (-1,-1), (3,-1), (-1,3), за счёт чего
// нет шва по диагонали и не нужен индексный буфер.
// ---------------------------------------------------------------------------

layout(location = 0) out vec2 v_uv;

void main()
{
    vec2 p = vec2(float((gl_VertexIndex << 1) & 2), float(gl_VertexIndex & 2));
    v_uv = p;
    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
}
