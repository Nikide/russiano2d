{
  "format": "r2d-snippet/1",
  "id": "animation.speed-scale",
  "version": "1.0.0",
  "title": {
    "ru": "Скорость анимации от игры"
  },
  "description": {
    "ru": "Скорость клипа ∝ скорости движения (бег быстрее — шаги чаще)."
  },
  "kind": "behavior",
  "category": "Анимация",
  "targets": [
    "node"
  ],
  "slots": [],
  "requires": [
    {
      "api": "$.fn.animate"
    },
    {
      "api": "$.fn.data"
    },
    {
      "api": "$.fn.max"
    },
    {
      "api": "$.fn.min"
    },
    {
      "api": "$.fn.velocity"
    },
    {
      "api": "$.updateFor"
    }
  ],
  "dependencies": [],
  "fields": [
    {
      "id": "clip",
      "label": "Кадры (a-b@базовая скорость)",
      "type": "string",
      "default": "4-9@10"
    },
    {
      "id": "refSpeed",
      "label": "Скорость движения для базовой",
      "type": "number",
      "default": 200,
      "min": 1,
      "max": 10000,
      "unit": "пикс./с"
    },
    {
      "id": "min",
      "label": "Минимум",
      "type": "number",
      "default": 0.3,
      "min": 0,
      "max": 10,
      "step": 0.05
    },
    {
      "id": "max",
      "label": "Максимум",
      "type": "number",
      "default": 2.5,
      "min": 0,
      "max": 10,
      "step": 0.05
    }
  ],
  "tags": [
    "анимация",
    "темп"
  ],
  "source": "src/behavior.js",
  "examples": [
    "examples/example.json"
  ],
  "tests": [
    "tests/values.test.json"
  ]
}
