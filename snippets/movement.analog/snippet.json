{
  "format": "r2d-snippet/1",
  "id": "movement.analog",
  "version": "1.0.0",
  "title": {
    "ru": "Аналоговый стик"
  },
  "description": {
    "ru": "Движение левым стиком геймпада с мёртвой зоной и кривой отклика."
  },
  "kind": "behavior",
  "category": "Персонаж и движение",
  "targets": [
    "node"
  ],
  "slots": [
    {
      "id": "movement",
      "capacity": 1
    }
  ],
  "requires": [
    {
      "api": "$.fn.min"
    },
    {
      "api": "$.fn.velocity"
    },
    {
      "api": "$.input.padAxis"
    },
    {
      "api": "$.updateFor"
    }
  ],
  "dependencies": [],
  "fields": [
    {
      "id": "speed",
      "label": "Скорость",
      "type": "number",
      "default": 240,
      "min": 0,
      "max": 900,
      "step": 5,
      "unit": "пикс./с"
    },
    {
      "id": "deadzone",
      "label": "Мёртвая зона",
      "type": "number",
      "default": 0.15,
      "min": 0,
      "max": 0.9,
      "step": 0.01
    },
    {
      "id": "curve",
      "label": "Кривая",
      "type": "number",
      "default": 1.5,
      "min": 0.5,
      "max": 4,
      "step": 0.1
    }
  ],
  "tags": [
    "геймпад",
    "стик"
  ],
  "source": "src/behavior.js",
  "examples": [
    "examples/example.json"
  ],
  "tests": [
    "tests/values.test.json",
    "tests/invalid.test.json"
  ]
}
