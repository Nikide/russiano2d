{
  "format": "r2d-snippet/1",
  "id": "interact.switch",
  "version": "1.0.1",
  "title": {
    "ru": "Переключатель"
  },
  "description": {
    "ru": "Переключатель вкл/выкл по interact или клавише; глобальные события вкл и выкл."
  },
  "kind": "behavior",
  "category": "Взаимодействие и мир",
