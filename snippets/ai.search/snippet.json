      "api": "$.fn.data"
    },
    {
      "api": "$.fn.emit"
    },
    {
      "api": "$.fn.moveTowards"
    },
    {
      "api": "$.fn.off"
    },
    {
      "api": "$.fn.on"
    },
    {
      "api": "$.fn.pos"
    },
    {
      "api": "$.updateFor"
    }
  ],
  "dependencies": [
    {
      "id": "ai.investigate"
    }
  ],
  "fields": [
