{
  "format": "r2d-snippet/1",
  "id": "camera.follow",
  "version": "1.0.0",
  "title": {
    "ru": "Камера следует за объектом"
  },
  "description": {
    "ru": "Камера следует за узлом с плавностью и зоной свободы."
  },
  "kind": "behavior",
  "category": "Камера",
  "targets": [
    "node"
  ],
  "slots": [
    {
      "id": "camera",
      "capacity": 1
    }
  ],
  "requires": [
    {
      "api": "$.camera.follow"
    }
  ],
  "dependencies": [],
  "fields": [
    {
      "id": "smooth",
      "label": "Плавность",
      "type": "number",
      "default": 0.12,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "id": "deadzone",
      "label": "Зона свободы",
      "type": "vec2",
      "default": [
        40,
        24
      ]
    },
    {
      "id": "lookahead",
      "label": "Взгляд вперёд",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "пикс."
    }
  ],
  "tags": [
    "камера"
  ],
  "source": "src/behavior.js",
  "examples": [
    "examples/example.json"
  ],
  "tests": [
    "tests/values.test.json",
    "tests/invalid.test.json"
  ]
}
