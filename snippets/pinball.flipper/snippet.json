    },
    {
      "api": "$.fn.emit"
    },
    {
      "api": "$.fn.overlaps"
    },
    {
      "api": "$.fn.velocity"
    },
    {
      "api": "$.input.down"
    },
    {
      "api": "$.selection.each"
    },
    {
      "api": "$.updateFor"
    }
  ],
  "dependencies": [],
  "fields": [
    {
      "id": "key",
      "label": "Клавиша",
