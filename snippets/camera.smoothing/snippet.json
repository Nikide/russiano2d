{
  "format": "r2d-snippet/1",
  "id": "camera.smoothing",
  "version": "1.0.0",
  "title": {
    "ru": "Сглаживание камеры"
  },
  "description": {
    "ru": "Плавное следование с ограничением времени догоняния."
