    {
      "api": "$.camera.follow"
    },
    {
      "api": "$.camera.isOnScreen"
    },
    {
      "api": "$.camera.unfollow"
    },
    {
      "api": "$.fn.at"
    },
    {
      "api": "$.fn.pos"
    },
    {
      "api": "$.selection.get"
    },
    {
      "api": "$.updateFor"
    }
  ],
  "dependencies": [],
  "fields": [
