      "id": "movement",
      "capacity": 1
    }
  ],
  "requires": [
    {
      "api": "$.fn.emit"
    },
    {
      "api": "$.fn.flip"
    },
    {
      "api": "$.fn.moveTowards"
    },
    {
      "api": "$.fn.pos"
    },
    {
      "api": "$.updateFor"
    }
  ],
  "dependencies": [],
  "fields": [
    {
      "id": "target",
      "label": "Цель",
      "type": "entity",
      "default": "#hero",
      "required": true
    },
    {
      "id": "distance",
      "label": "Дистанция",
      "type": "number",
      "default": 120,
      "min": 10,
      "max": 5000,
      "unit": "пикс."
    },
    {
      "id": "side",
      "label": "Сторона",
      "type": "enum",
      "default": "auto",
      "options": [
        "auto",
        "left",
        "right"
      ]
    },
    {
      "id": "speed",
      "label": "Скорость",
      "type": "number",
      "default": 140,
      "min": 0,
      "max": 900,
      "step": 5,
      "unit": "пикс./с"
    }
  ],
  "tags": [
    "тактика",
    "фланг"
  ],
  "source": "src/behavior.js",
  "examples": [
