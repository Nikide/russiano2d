{
  "format": "r2d-snippet/1",
  "id": "ai.flank",
  "version": "1.0.0",
  "title": {
    "ru": "Обход с фланга"
  },
  "description": {
    "ru": "Выходит на боковую позицию относительно взгляда цели."
