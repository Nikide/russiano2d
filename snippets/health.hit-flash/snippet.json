{
  "format": "r2d-snippet/1",
  "id": "health.hit-flash",
  "version": "1.0.0",
  "title": {
    "ru": "Вспышка при уроне"
  },
  "description": {
    "ru": "Подсвечивает объект цветом, когда убывает здоровье."
  },
  "kind": "behavior",
  "category": "Бой и здоровье",
  "targets": [
    "node"
  ],
  "slots": [],
  "requires": [
    {
      "api": "$.fn.flash"
    },
    {
      "api": "$.fn.hp"
    },
    {
      "api": "$.updateFor"
    }
  ],
  "dependencies": [
    {
      "id": "health.base"
    }
  ],
  "fields": [
    {
      "id": "color",
      "label": "Цвет",
      "type": "color",
      "default": "#ff4040"
