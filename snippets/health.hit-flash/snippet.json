    {
      "id": "duration",
      "label": "Длительность",
      "type": "int",
      "default": 120,
      "min": 10,
      "max": 2000,
      "unit": "мс"
    }
  ],
  "tags": [
    "урон",
    "вспышка",
    "feedback"
  ],
  "source": "src/behavior.js",
  "examples": [
    "examples/example.json"
  ],
  "tests": [
    "tests/values.test.json",
    "tests/invalid.test.json"
  ]
}
