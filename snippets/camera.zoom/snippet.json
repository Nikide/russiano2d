{
  "format": "r2d-snippet/1",
  "id": "camera.zoom",
  "version": "1.0.0",
  "title": {
    "ru": "Масштаб камеры"
  },
  "description": {
    "ru": "Задаёт масштаб камеры, пока объект в мире."
  },
  "kind": "behavior",
  "category": "Камера",
  "targets": [
    "node"
  ],
  "slots": [
    {
      "id": "camera-zoom",
      "capacity": 1
    }
  ],
  "requires": [
    {
      "api": "$.camera.zoom"
    },
    {
      "api": "$.camera.zoomTo"
    }
  ],
  "dependencies": [],
  "fields": [
    {
      "id": "zoom",
      "label": "Масштаб",
      "type": "number",
      "default": 1.5,
      "min": 0.1,
      "max": 8,
      "step": 0.05
    },
    {
      "id": "duration",
      "label": "Переход",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 10000,
      "unit": "мс"
    }
  ],
  "tags": [
    "камера",
    "zoom"
  ],
  "source": "src/behavior.js",
  "examples": [
    "examples/example.json"
  ],
  "tests": [
    "tests/values.test.json"
  ]
}
