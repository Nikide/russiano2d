{
  "format": "r2d-snippet/1",
  "id": "audio.ducking",
  "version": "1.0.0",
  "title": {
    "ru": "Приглушение музыки"
  },
  "description": {
    "ru": "Музыка приглушается на время важного события (реплика, взрыв)."
  },
  "kind": "behavior",
