  "targets": [
    "project",
    "node"
  ],
  "slots": [],
  "requires": [
    {
      "api": "$.audio.musicVolume"
    },
    {
      "api": "$.fn.off"
    },
    {
      "api": "$.fn.on"
    },
    {
      "api": "$.off"
    },
    {
      "api": "$.on"
    },
    {
      "api": "$.updateFor"
    }
  ],
  "dependencies": [],
  "fields": [
    {
      "id": "events",
      "label": "События",
      "type": "list",
      "default": [
        "say",
        "explosion"
      ]
