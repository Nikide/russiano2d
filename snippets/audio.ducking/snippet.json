      "default": 1500,
      "min": 0,
      "max": 30000,
      "unit": "мс"
    }
  ],
  "tags": [
    "музыка",
    "микс"
  ],
  "source": "src/behavior.js",
  "examples": [
    "examples/example.json"
  ],
  "tests": [
