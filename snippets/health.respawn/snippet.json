    },
    {
      "api": "$.fn.emit"
    },
    {
      "api": "$.fn.respawn"
    },
    {
      "api": "$.updateFor"
    }
  ],
  "dependencies": [
    {
      "id": "health.base"
    }
  ],
  "fields": [
    {
      "id": "point",
      "label": "Точка возрождения",
