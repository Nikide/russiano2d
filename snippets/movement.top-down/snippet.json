{
  "format": "r2d-snippet/1",
  "id": "movement.top-down",
  "version": "1.0.0",
  "title": {
    "ru": "Движение сверху"
  },
  "description": {
    "ru": "Движение в восьми направлениях для top-down."
  },
  "kind": "behavior",
  "category": "Персонаж и движение",
  "targets": [
    "node"
  ],
  "slots": [
    {
      "id": "movement",
      "capacity": 1
    }
  ],
  "requires": [
    {
      "api": "$.fn.velocity"
    },
    {
      "api": "$.input.vec"
    },
    {
      "api": "$.updateFor"
    }
  ],
  "dependencies": [],
  "fields": [
    {
      "id": "speed",
      "label": "Скорость",
      "type": "number",
      "default": 200,
      "min": 0,
      "max": 900,
      "step": 5,
      "unit": "пикс./с"
    },
    {
      "id": "keys",
      "label": "Клавиши",
      "type": "enum",
      "default": "wasd",
      "options": [
        "wasd",
        "arrows"
      ]
    }
  ],
  "tags": [
    "игрок",
    "top-down"
  ],
  "source": "src/behavior.js",
  "examples": [
    "examples/example.json"
  ],
  "tests": [
    "tests/values.test.json",
    "tests/invalid.test.json"
  ]
}
