{
  "format": "r2d-snippet/1",
  "id": "net.prediction-profile",
  "version": "1.0.0",
  "title": {
    "ru": "Предсказание ввода"
  },
  "description": {
    "ru": "Локальное предсказание движения ($.net.predict) с откатом при подтверждении."
