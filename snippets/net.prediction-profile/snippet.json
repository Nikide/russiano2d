    {
      "api": "$.fn.at"
    },
    {
      "api": "$.net.isAuthority"
    },
    {
      "api": "$.net.online"
    },
    {
      "api": "$.net.predict"
    },
    {
      "api": "$.net.prediction"
    },
    {
      "api": "$.updateFor"
    }
  ],
  "dependencies": [],
