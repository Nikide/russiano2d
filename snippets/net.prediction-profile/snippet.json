      "label": "Сглаживание коррекции",
      "type": "number",
      "default": 0.2,
      "min": 0,
      "max": 1,
      "step": 0.05
    }
  ],
  "tags": [
    "предсказание",
    "лаг"
  ],
  "source": "src/behavior.js",
  "examples": [
    "examples/example.json"
  ],
  "tests": [
    "tests/values.test.json"
  ]
