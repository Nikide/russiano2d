      "api": "$.emit"
    },
    {
      "api": "$.fn.emit"
    },
    {
      "api": "$.fn.overlaps"
    },
    {
      "api": "$.fn.some"
    },
    {
      "api": "$.selection.get"
    },
    {
      "api": "$.store"
    },
    {
      "api": "$.store.get"
    },
    {
      "api": "$.store.set"
    },
    {
      "api": "$.updateFor"
    }
  ],
  "dependencies": [],
