  "kind": "behavior",
  "category": "Взаимодействие и мир",
  "targets": [
    "node"
  ],
  "slots": [],
  "requires": [
    {
      "api": "$.emit"
    },
    {
      "api": "$.fn.attr"
    },
    {
      "api": "$.fn.data"
    },
    {
      "api": "$.fn.emit"
    },
    {
      "api": "$.fn.overlaps"
    },
    {
      "api": "$.selection.each"
    },
    {
      "api": "$.selection.get"
    },
    {
      "api": "$.updateFor"
    }
  ],
  "dependencies": [],
  "fields": [
    {
      "id": "who",
      "label": "Кто нажимает",
      "type": "string",
      "default": ".player, .crate"
    },
    {
      "id": "need",
      "label": "Нужно узлов",
      "type": "int",
      "default": 1,
      "min": 1,
      "max": 64
    },
    {
      "id": "pressEvent",
      "label": "Событие нажатия",
