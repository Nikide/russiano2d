/* Интерфейс демо Real2D v4. В RmlUi элементы по умолчанию inline, поэтому
   display: block задан явно — иначе строки наезжают друг на друга. */
body {
    font-family: Noto Sans;
    font-size: 18px;
    color: #e8eef6;
    width: 100%;
    height: 100%;
}

#heading {
    display: block;
    position: absolute;
    left: 3vw;
    top: 3vh;
    width: 44vw;
}

#kicker {
    display: block;
    color: #7fd1ff;
    font-size: 1.4vh;
    letter-spacing: 2px;
}

h1 {
    display: block;
    font-size: 4vh;
    margin: 0.6vh 0;
    color: #ffffff;
}

#sub {
    display: block;
    color: #9fb0c8;
    font-size: 1.7vh;
    margin: 0;
}

#readout {
    display: block;
    position: absolute;
    right: 3vw;
    top: 3vh;
    width: 30vw;
    padding: 1.6vh 1.6vw;
    background-color: rgba(9, 13, 21, 200);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(127, 209, 255, 70);
    text-align: right;
}

#readout p {
    display: block;
    margin: 0 0 0.6vh 0;
    font-size: 1.6vh;
    color: #cdd8e6;
}

#yaw-line {
    font-size: 2.2vh;
    color: #7fd1ff;
}

#controls {
    display: flex;
    position: absolute;
    left: 3vw;
    bottom: 3vh;
    width: 94vw;
    align-items: center;
}

button {
    display: block;
    margin-right: 0.8vw;
    padding: 0.8vh 1.2vw;
    font-size: 1.7vh;
    color: #0e1420;
    background-color: #7fd1ff;
    border-radius: 8px;
}

button:hover {
    background-color: #a9e2ff;
}

#controls span {
    display: block;
    margin-left: 1vw;
    font-size: 1.5vh;
    color: #8fa0b6;
}
