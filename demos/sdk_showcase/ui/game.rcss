body { width:100%; height:100%; font-family:"Open Sans"; color:#e8f5f2; }
#hud { position:absolute; left:24px; top:22px; width:400px; padding:20px; background-color:rgba(5,18,27,220); border-width:1px; border-color:#367b77; border-radius:12px; }
.brand { font-size:22px; color:#83efd2; }
.brand span { font-size:12px; color:#f7c979; }
#coords { margin-top:8px; font-size:15px; color:#c0d8d8; }
#status { margin-top:8px; font-size:16px; color:#f7c979; }
button { display:inline-block; margin-top:14px; margin-right:8px; padding:10px 14px; color:#061a1b; background-color:#83efd2; border-radius:6px; font-size:14px; }
button:hover { background-color:#b4ffe8; }
.hint { margin-top:12px; font-size:12px; color:#9cb8bb; }
