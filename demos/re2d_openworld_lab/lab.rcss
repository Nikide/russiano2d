body { width: 100%; height: 100%; font-family: Noto Sans; font-size: 16px; color: #e7edf3; }
#panel { position: absolute; top: 14px; left: 16px; right: 16px; padding: 12px; background-color: #0b1420d9; border-radius: 6px; }
#title { display: block; font-size: 18px; color: #ffd28a; }
#status { display: block; margin-top: 6px; font-size: 15px; }
#stats { display: block; margin-top: 4px; color: #a5b5c8; font-size: 13px; }
#keys { display: block; margin-top: 6px; color: #7f91a6; font-size: 12px; }
