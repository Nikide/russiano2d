body { width: 100%; height: 100%; font-family: Noto Sans; font-size: 15px; color: #fff; }
#panel { position: absolute; left: 16px; right: 16px; top: 12px; padding: 9px; background-color: #101820dd; }
#floor { display: block; font-size: 18px; margin-bottom: 6px; }
#keys { display: block; color: #bcd2da; font-size: 12px; }
#cross { position: absolute; left: 50%; top: 50%; font-size: 20px; margin-left: -6px; margin-top: -14px; }
