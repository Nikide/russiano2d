/* ---------------------------------------------------------------------------
   Эталонное меню настроек — стили.

   Вёрстка АДАПТИВНАЯ, как у меню-лаунчера: сцена движка всегда 16:9, поэтому
   размеры заданы в vh (процент высоты сцены). Пиксельных размеров здесь нет —
   на другом разрешении такое меню «рассыпается».

   Цвета состояний строки:
     .row          — обычная строка;
     .row:hover    — курсор мыши;
     .row.sel      — кольцо выбора (клавиатура и геймпад);
     .row.capture  — идёт захват клавиши (строка мигает рамкой).
   --------------------------------------------------------------------------- */

body {
    font-family: Open Sans;
    font-size: 1.9vh;
    color: #eef2f8;
    width: 100%;
    height: 100%;
}

#scrim {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    background-color: rgba(6, 9, 16, 190);
}

#panel {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 2;
    width: 62vw;
    max-width: 1080px;
    height: 78vh;
    margin: 6vh auto 0 auto;
    padding: 2.4vh 3vh;
    background-color: #131a27;
    border: 0.25vh solid #2b3a54;
    border-radius: 1.2vh;
}

#head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 0.2vh solid #2b3a54;
    padding-bottom: 1vh;
}

h1 {
    font-size: 3vh;
    margin: 0;
}

#fps {
    color: #7f8ea8;
    font-size: 1.6vh;
}

/* --- Вкладки ------------------------------------------------------------- */

#tabs {
    display: flex;
    gap: 1vh;
    margin: 1.4vh 0;
}

.tab {
    padding: 0.8vh 1.6vh;
    background-color: #1b2434;
    border: 0.2vh solid #2b3a54;
    border-radius: 0.8vh;
    color: #cfd8e6;
}

.tab:hover {
    background-color: #22304a;
}

.tab.on {
    background-color: #2c4a7c;
    border-color: #4d7fd6;
    color: #ffffff;
}

/* --- Страницы и строки --------------------------------------------------- */

#pages {
    flex: 1;
    overflow: auto;
}

.page {
    display: none;
}

.page.on {
    display: block;
}

.row {
    display: flex;
    align-items: center;
    gap: 1.4vh;
    padding: 1vh 1.2vh;
    border: 0.2vh solid transparent;
    border-radius: 0.8vh;
}

.row:hover {
    background-color: #1a2436;
}

.row.sel {
    background-color: #1d2c46;
    border-color: #4d7fd6;
}

.row.capture {
    border-color: #ffb454;
    background-color: #2a2313;
}

.label {
    flex: 1;
}

.val {
    min-width: 12vh;
    text-align: right;
    color: #b9c6da;
}

.key {
    min-width: 12vh;
    text-align: center;
    padding: 0.2vh 0.8vh;
    background-color: #0f1622;
    border: 0.2vh solid #33445f;
    border-radius: 0.6vh;
    color: #ffd479;
}

.bar {
    width: 22vh;
    height: 1.4vh;
    background-color: #0f1622;
    border: 0.2vh solid #33445f;
    border-radius: 0.7vh;
    overflow: hidden;
}

.fill {
    display: block;
    height: 100%;
    width: 50%;
    background-color: #4d7fd6;
}

.hint {
    margin: 1vh 1.2vh 0 1.2vh;
    color: #7f8ea8;
    font-size: 1.6vh;
    line-height: 1.35;
}

/* --- Состояние и подсказки ----------------------------------------------- */

#status {
    margin-top: 1vh;
    padding-top: 1vh;
    border-top: 0.2vh solid #2b3a54;
    color: #9fb0c8;
    font-size: 1.6vh;
    min-height: 2.2vh;
}

#foot {
    display: flex;
    justify-content: space-between;
    margin-top: 0.8vh;
    color: #6f7f99;
    font-size: 1.5vh;
}
