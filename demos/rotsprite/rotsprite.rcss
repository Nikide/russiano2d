body { font-family: Open Sans; font-size: 1.8vh; color: #e8eee6; width: 100%; height: 100%; }
#heading { position: absolute; left: 4vw; top: 4vh; }
#kicker { display: block; color: #92c989; font-size: 1.5vh; letter-spacing: 2px; }
h1 { display: block; font-size: 4.5vh; margin: 0.8vh 0; }
h2 { display: block; font-size: 2.1vh; margin: 0 0 0.6vh 0; }
p { display: block; color: #a5b2af; margin: 0; }
#atlas-caption { position: absolute; left: 4vw; top: 19vh; }
#head-caption { position: absolute; left: 52vw; top: 19vh; }
#pose { color: #92c989; }
#note { position: absolute; left: 4vw; top: 77vh; width: 34vw; color: #a5b2af; line-height: 1.6; }
#pitch-caption { position: absolute; left: 52vw; top: 69vh; color: #a5b2af; }
#controls { position: absolute; left: 4vw; bottom: 3vh; width: 92vw; display: flex; align-items: center; }
button { background-color: #263a33; border-width: 1px; border-color: #4d6957; padding: 1.2vh 1.2vw; margin-right: 0.6vw; color: #e8eee6; }
button:hover { background-color: #3e5b43; }
#controls span { margin-left: 1.2vw; font-size: 1.5vh; color: #a5b2af; }
#controls-extra { position: absolute; left: 4vw; bottom: 10vh; width: 92vw; display: flex; align-items: center; }
#controls-extra span { margin-left: 1.2vw; color: #a5b2af; font-size: 1.5vh; }
#pitch-caption { top: 66vh; }
#note { top: 73vh; font-size: 1.6vh; }
#error { color: #ff987f; }

#handLeft, #handRight { position: absolute; width: 16px; height: 16px; border-width: 1px; border-color: #a3c49b; border-radius: 8px; pointer-events: none; opacity: 0.45; }
