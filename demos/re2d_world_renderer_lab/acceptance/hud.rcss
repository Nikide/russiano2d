body { width: 100%; height: 100%; font-family: Noto Sans; font-size: 16px; color: #e7edf3; } #panel { position: absolute; top: 14px; left: 16px; right: 16px; padding: 12px; background-color: #0b1420d9; border-radius: 6px; } #status { display: block; font-size: 18px; } #keys { display: block; margin-top: 6px; color: #a5b5c8; font-size: 13px; } #cross { position: absolute; left: 50%; top: 50%; font-size: 20px; }
