<rml>
<head>
    <link type="text/rcss" href="shooter-death.rcss"/>
    <title>Игра окончена</title>
</head>
<body>
    <div id="over">
        <h1>Вас одолели</h1>
        <p class="stat">Очки: <span id="death-score">0</span></p>
        <p class="stat">Убито врагов: <span id="death-kills">0 / 0</span></p>
        <button id="death-retry">Заново</button>
        <button id="death-menu">В меню</button>
    </div>
</body>
</rml>
