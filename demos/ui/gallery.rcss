/* Галерея анимаций: панель управления справа. Фон и сетку миниатюр
   рисует сама сцена через SpriteBatch, поэтому body прозрачный. */

body {
    font-family: Noto Sans;
    font-size: 16px;
    color: #eef2f8;
    width: 100%;
    height: 100%;
}

#side {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 286px;
    padding: 16px 18px 14px 18px;
    background-color: rgba(9, 13, 21, 224);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(201, 166, 255, 97);
}

h1 {
    font-size: 26px;
    color: #c9a6ff;
    margin-bottom: 6px;
    text-align: center;
}

#sheet-name {
    font-size: 15px;
    color: #ffd873;
    text-align: center;
    margin-bottom: 0px;
}

#sheet-counter {
    font-size: 13px;
    color: #93a4bb;
    text-align: center;
    margin-bottom: 12px;
}

.cap {
    font-size: 12px;
    color: #7c8ca3;
    margin-top: 12px;
    margin-bottom: 4px;
}

/* --- Кнопки ------------------------------------------------------------- */

button {
    font-family: Noto Sans;
    font-size: 15px;
    color: #eef2f8;
    background-color: rgba(38, 54, 76, 242);
    border-width: 1px;
    border-color: #34536f;
    border-radius: 7px;
    padding: 6px 8px;
    text-align: center;
}

button:hover {
    background-color: rgba(58, 84, 116, 242);
    border-color: #c9a6ff;
}

button:active {
    background-color: rgba(78, 108, 148, 242);
}

.row {
    display: block;
    text-align: center;
}

.row .nav {
    display: inline-block;
    width: 108px;
    margin: 0px 3px;
    padding: 7px 6px;
}

.row .nav.small {
    width: 40px;
}

#row-label {
    display: inline-block;
    width: 92px;
    color: #ffd873;
    font-size: 15px;
}

#states {
    display: block;
}

.state {
    display: block;
    width: 100%;
    margin-top: 5px;
    text-align: left;
    padding-left: 12px;
}

.state.active {
    background-color: rgba(96, 74, 148, 242);
    border-color: #c9a6ff;
    color: #ffffff;
}

#speed {
    display: block;
    text-align: center;
}

.spd {
    display: inline-block;
    width: 52px;
    font-size: 13px;
    padding: 5px 2px;
    margin: 0px 1px;
}

.spd.active {
    background-color: rgba(96, 74, 148, 242);
    border-color: #c9a6ff;
    color: #ffffff;
}

#speed-label {
    font-size: 13px;
    color: #ffd873;
    text-align: center;
    margin-top: 6px;
    margin-bottom: 4px;
}

.wide {
    display: block;
    width: 100%;
    margin-top: 10px;
    padding: 8px 0px;
    font-size: 16px;
    color: #eef2f8;
}

#hint {
    margin-top: 12px;
    font-size: 12px;
    color: #7c8ca3;
    text-align: center;
}
