<rml>
<head>
    <link type="text/rcss" href="gallery.rcss"/>
    <title>Галерея анимаций</title>
</head>
<body>
    <!-- Панель управления: прижата к правому краю, сцену рисует GalleryScene. -->
    <div id="side">
        <h1>ГАЛЕРЕЯ</h1>
        <p id="sheet-name">нет листов</p>
        <p id="sheet-counter">0 / 0</p>

        <div class="row">
            <button id="prev" class="nav">Пред</button>
            <button id="next" class="nav">След</button>
        </div>

        <p class="cap">Состояние (клавиши 1-4)</p>
        <div id="states">
            <button id="state-0" class="state">1  Покой</button>
            <button id="state-1" class="state">2  Прицел</button>
            <button id="state-2" class="state">3  Выстрел</button>
            <button id="state-3" class="state">4  Смерть</button>
        </div>

        <p class="cap">Ряд листа</p>
        <div class="row">
            <button id="row-prev" class="nav small">-</button>
            <span id="row-label">ряд 0</span>
            <button id="row-next" class="nav small">+</button>
        </div>

        <p class="cap">Скорость</p>
        <div id="speed">
            <button id="spd-0" class="spd">x0.25</button>
            <button id="spd-1" class="spd">x0.5</button>
            <button id="spd-2" class="spd">x1</button>
            <button id="spd-3" class="spd">x1.5</button>
            <button id="spd-4" class="spd">x2</button>
        </div>
        <p id="speed-label">x1.00 · 12 кадр/с</p>

        <button id="pause" class="wide">Пауза</button>

        <p id="hint">
            A/D или стрелки — лист, 1-4 — состояние, Space — пауза,
            W/S или колесо — прокрутка сетки, Esc — в меню
        </p>
    </div>
</body>
</rml>
