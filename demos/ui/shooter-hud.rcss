/* HUD 2.5D шутера. Панель сверху, чтобы не закрывать центр обзора. */

body {
    font-family: Noto Sans;
    font-size: 18px;
    color: #ffffff;
}

#bar {
    display: block;
    width: 780px;
    margin-left: auto;
    margin-right: auto;
    margin-top: 8px;
    padding: 5px 14px 7px 14px;
    background-color: rgba(8, 10, 16, 190);
    border-radius: 8px;
    text-align: center;
}

#stats {
    display: block;
}

#bar .cell {
    display: inline-block;
    width: 185px;
}

#bar .label {
    color: #93a4bb;
    font-size: 13px;
}

#bar .value {
    display: block;
    font-size: 23px;
    color: #ffd873;
}

/* Подсказка — обычным блоком внутри панели. absolute+bottom в RmlUi
   позиционируется относительно непредсказуемой коробки и налезала на
   счётчики, из-за чего текст читался внахлёст. */
#help {
    display: block;
    margin-top: 3px;
    font-size: 13px;
    color: #8c9cb2;
}
