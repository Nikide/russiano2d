/* ---------------------------------------------------------------------------
   Меню-лаунчер демо.

   Вёрстка АДАПТИВНАЯ. Сцена движка всегда 16:9 (в вебе это гарантирует
   #stage в web/shell.html, нативно — окно), поэтому все размеры заданы в vh —
   один процент высоты сцены. При любом размере окна интерфейс масштабируется
   пропорционально: и в 1280×720, и в 1920×1080, и в маленьком окне выглядит
   одинаково. Фиксированных пиксельных размеров здесь быть не должно —
   именно из-за них меню раньше «рассыпалось» на других разрешениях.
   --------------------------------------------------------------------------- */

body {
    font-family: Open Sans;
    font-size: 2.2vh;
    color: #eef2f8;
    width: 100%;
    height: 100%;
}

/* Фон и затемнение — на всю сцену, в процентах. z-index обязателен: фон
   позиционирован абсолютно, а такой слой рисуется выше обычного потока —
   без явных слоёв панель оказывается ПОД картинкой. */
#bg {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
}

#scrim {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    background-color: rgba(7, 10, 17, 130);
}

#panel {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 2;
    width: 78vw;
    max-width: 1600px;
    margin: 5vh auto 0 auto;
    padding: 3vh 4vh;
    background-color: rgba(9, 13, 21, 234);
    border-radius: 1.6vh;
    border-width: 1px;
    border-color: rgba(127, 209, 255, 92);
}

h1 {
    display: block;
    width: 100%;
    font-size: 6.2vh;
    color: #7fd1ff;
    text-align: center;
    margin-bottom: 0.6vh;
}

#tagline {
    display: block;
    width: 100%;
    font-size: 2.1vh;
    color: #93a4bb;
    text-align: center;
    margin-bottom: 3vh;
}

/* --- Карточки демо ------------------------------------------------------ */

#demo-list {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 1.6vh;
    justify-content: space-between;
}

.demo {
    display: flex;
    flex-direction: column;
    flex: 1 1 44%;
    padding: 2.2vh 2.6vh;
    background-color: rgba(28, 40, 58, 242);
    border-radius: 1.4vh;
    border-width: 1px;
    border-color: #2c4a6e;
}

.demo:hover {
    background-color: rgba(44, 82, 124, 246);
    border-color: #7fd1ff;
}

.demo:active {
    background-color: rgba(64, 118, 176, 246);
}

/* Иконка из встроенного шрифта Material Design: engine.ui.icon(...) */
.demo .ico {
    display: block;
    font-family: Material Icons;
    font-size: 5.2vh;
    color: #7fd1ff;
}

.demo .t {
    display: block;
    font-size: 3.2vh;
    color: #eaf4ff;
    margin-top: 0.8vh;
}

.demo .s {
    display: block;
    font-size: 2.1vh;
    color: #9fb2c9;
    margin-top: 0.6vh;
}

/* --- Громкость ---------------------------------------------------------- */

#footer {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 1.4vh;
    margin-top: 3vh;
}

#footer .label {
    color: #93a4bb;
    font-size: 2.1vh;
}

#footer button.small {
    display: block;
    width: 6.4vh;
    padding: 0.6vh 0;
    font-family: Material Icons;
    font-size: 2.8vh;
    background-color: rgba(38, 54, 76, 242);
    color: #cfe3f5;
    border-width: 1px;
    border-color: #34536f;
    border-radius: 1vh;
    text-align: center;
}

#footer button.small:hover {
    background-color: rgba(58, 84, 116, 246);
    border-color: #7fd1ff;
}

#vol-value {
    display: block;
    width: 8vh;
    text-align: center;
    color: #ffd873;
    font-size: 2.1vh;
}

/* --- Подсказки ---------------------------------------------------------- */

#hint {
    display: block;
    width: 100%;
    margin-top: 2.6vh;
    font-size: 1.9vh;
    color: #8496ad;
    text-align: center;
    line-height: 1.5;
}

#selected {
    display: block;
    width: 100%;
    margin-top: 1.2vh;
    font-size: 2.4vh;
    color: #ffd873;
    text-align: center;
}
