/* Панель демо BSP. Фон рисует сцена, поэтому body прозрачный. */

body {
    font-family: Noto Sans;
    font-size: 18px;
    color: #eef2f8;
}

#panel {
    display: block;
    width: 330px;
    margin: 14px;
    padding: 14px 18px;
    background-color: rgba(9, 13, 21, 216);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(127, 209, 255, 84);
}

h1 {
    display: block;
    width: 100%;
    font-size: 22px;
    color: #7fd1ff;
    margin-bottom: 2px;
}

.sub {
    display: block;
    width: 100%;
    font-size: 12px;
    color: #93a4bb;
    margin-bottom: 10px;
}

.row {
    display: block;
    width: 100%;
    margin-bottom: 2px;
}

.row .k {
    color: #93a4bb;
    font-size: 14px;
}

.row .v {
    display: block;
    float: right;
    color: #ffd873;
    font-size: 17px;
}

button {
    display: block;
    width: 100%;
    margin-top: 6px;
    padding: 7px 10px;
    font-size: 15px;
    color: #0d1220;
    background-color: #7fd1ff;
    border-width: 0px;
    border-radius: 7px;
    text-align: center;
}

button:hover {
    background-color: #a9e0ff;
}

#hint {
    display: block;
    width: 100%;
    margin-top: 10px;
    font-size: 12px;
    color: #7c8ca3;
}
