body {
    font-family: Noto Sans;
    font-size: 18px;
    color: #eef2f8;
    width: 100%;
    height: 100%;
    background-color: rgba(6, 9, 15, 184);
}

#pause {
    display: block;
    width: 420px;
    margin-left: auto;
    margin-right: auto;
    margin-top: 210px;
    padding: 26px;
    background-color: rgba(12, 18, 28, 240);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(127, 209, 255, 89);
    text-align: center;
}

h1 {
    font-size: 34px;
    color: #7fd1ff;
    margin-bottom: 4px;
}

#pause-info {
    color: #9fb0c8;
    margin-bottom: 20px;
}

#pause-score {
    color: #ffd873;
    font-size: 22px;
}

button {
    display: block;
    width: 260px;
    margin-left: auto;
    margin-right: auto;
    margin-top: 10px;
    padding: 12px;
    font-size: 18px;
    color: #0d1220;
    background-color: #7fd1ff;
    border-width: 0px;
    border-radius: 8px;
    text-align: center;
}

button:hover {
    background-color: #a9e0ff;
}

#pause-hint {
    margin-top: 18px;
    font-size: 14px;
    color: #7c8ca3;
}
