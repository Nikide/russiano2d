/* HUD песочницы «Физика». Фон сцены (небо, земля, ящики) рисует сама сцена,
   поэтому body прозрачный, а панель управления висит сверху во всю ширину.

   Две особенности этой сборки RmlUi:
     * width: 100% у дочернего блока body резолвится в 0 — панель тянем по
       краям через position: absolute; left/right: 0;
     * альфа в rgba() задаётся целым 0..255, а не дробью 0..1.
*/

body {
    font-family: Noto Sans;
    font-size: 16px;
    color: #eef2f8;
    width: 100%;
    height: 100%;
}

#hud {
    position: absolute;
    left: 0px;
    right: 0px;
    top: 0px;
    display: block;
    background-color: rgba(9, 13, 21, 230);
    border-width: 1px;
    border-color: rgba(127, 209, 255, 90);
}

.row {
    display: block;
    margin-top: 8px;
    margin-bottom: 0px;
    margin-left: 16px;
    margin-right: 16px;
}

/* --- Кнопки ------------------------------------------------------------- */

button {
    display: inline-block;
    margin-right: 8px;
    padding: 6px 14px;
    font-size: 16px;
    color: #eef2f8;
    background-color: rgba(28, 40, 58, 240);
    border-width: 1px;
    border-color: #2c4a6e;
    border-radius: 8px;
}

button:hover {
    background-color: rgba(44, 82, 124, 245);
    border-color: #7fd1ff;
}

button:active {
    background-color: rgba(64, 118, 176, 245);
}

#boom {
    color: #ffc0c0;
    border-color: #8a3b3b;
}

#boom:hover {
    background-color: rgba(120, 44, 44, 245);
    border-color: #ff8686;
}

/* --- Подписи и статистика ----------------------------------------------- */

.label {
    display: inline-block;
    margin-right: 8px;
    color: #94a6bd;
}

.stat {
    display: inline-block;
    margin-right: 26px;
    color: #94a6bd;
}

.val {
    color: #ffd873;
}

#hint {
    display: block;
    margin-top: 8px;
    margin-bottom: 10px;
    margin-left: 16px;
    margin-right: 16px;
    font-size: 13px;
    color: #7c8ca3;
}
