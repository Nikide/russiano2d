<rml>
<head>
    <link type="text/rcss" href="physics.rcss"/>
    <title>Физика — песочница Box2D</title>
</head>
<body>
    <div id="hud">
        <div class="row">
            <button id="add-boxes">Ящиков +10</button>
            <button id="boom" class="danger">Взрыв</button>
            <button id="clear">Очистить</button>
            <button id="rebuild">Пересоздать уровень</button>
            <button id="toggle-bodies">Показывать тела: выкл</button>
        </div>
        <div class="row">
            <span class="label">Гравитация:</span>
            <button id="grav-earth" class="grav">Земная</button>
            <button id="grav-moon" class="grav">Луна</button>
            <button id="grav-zero" class="grav">Невесомость</button>
        </div>
        <div class="row">
            <span class="stat">Тел: <span id="stat-bodies" class="val">0</span></span>
            <span class="stat">FPS: <span id="stat-fps" class="val">0</span></span>
            <span class="stat">Гравитация: <span id="stat-gravity" class="val">0, 0</span></span>
        </div>
        <p id="hint">ЛКМ — новый ящик &nbsp;·&nbsp; A/D или стрелки — игрок &nbsp;·&nbsp; Space/W — прыжок &nbsp;·&nbsp; Esc — назад в меню</p>
    </div>
</body>
</rml>
