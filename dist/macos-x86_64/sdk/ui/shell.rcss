/* ---------------------------------------------------------------------------
   Russiano2D SDK — оболочка (launcher). Весь интерфейс — RmlUi.
   Общие компоненты — theme.rcss (подключается ссылкой в .rml: RmlUi не знает @import).
   --------------------------------------------------------------------------- */

body {
    font-family: Open Sans;
    font-size: 15px;
    color: #e9edf6;
    width: 100%;
    height: 100%;
    background-color: #0b0e14;
}

#app { display: flex; flex-direction: column; width: 100%; height: 100%; }

/* --- Верхняя полоса ------------------------------------------------------------ */
#topbar {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex: 0 0 auto;
    padding: 12px 22px;
    background-color: #0f131c;
    border-bottom-width: 1px;
    border-color: #232b3d;
}
#brand { font-size: 20px; color: #e9edf6; margin-right: 10px; }
#brand em { color: #ff5a3c; font-style: normal; }
#brand-ver { margin-right: 18px; }
#project-badge { margin-right: 10px; }
#topbar-spacer { flex: 1 1 0; }

/* --- Основная часть -------------------------------------------------------------- */
#main { display: flex; flex-direction: row; flex: 1 1 0; min-height: 0px; }

#nav {
    display: block;
    flex: 0 0 214px;
    width: 214px;
    box-sizing: border-box;
    padding: 18px 12px;
    background-color: #0f131c;
    border-right-width: 1px;
    border-color: #232b3d;
    overflow-y: auto;
}
.nav-group { display: block; margin: 14px 0px 6px 10px; color: #6f7a92; font-size: 11px; letter-spacing: 2px; }
.nav-btn {
    display: block;
    width: auto;
    margin: 0px 0px 4px 0px;
    padding: 9px 14px;
    text-align: left;
    color: #97a2b8;
    background-color: transparent;
    border-width: 1px;
    border-color: transparent;
    border-radius: 10px;
    cursor: pointer;
    transition: background-color 0.12s cubic-out, color 0.12s cubic-out;
}
.nav-btn:hover { color: #e9edf6; background-color: #171e2f; }
.nav-btn:active { background-color: #1f2740; transform: translateY(1px); }
.nav-btn.on { color: #ffb03a; background-color: #2a1a1c; border-color: #4a2a26; }
#nav-version { margin: 22px 0px 0px 10px; color: #5d6882; font-size: 12px; }

#content {
    display: block;
    flex: 1 1 0;
    min-width: 0px;
    padding: 26px 34px 30px 34px;
    overflow-y: auto;
}
.view { display: block; }
.view.hidden { display: none; }

/* --- Нижняя панель диагностики -------------------------------------------------------- */
#diag { display: block; flex: 0 0 auto; background-color: #0a0d13; border-top-width: 1px; border-color: #232b3d; }
#diag-head { display: flex; flex-direction: row; align-items: center; padding: 6px 18px; background-color: #0f131c; }
#diag-title { color: #ffb03a; font-size: 12px; letter-spacing: 2px; margin-right: 14px; }
#diag-counts { flex: 1 1 0; color: #97a2b8; font-size: 12px; }
#diag-list { display: block; height: 92px; overflow-y: auto; padding: 4px 18px; }

/* --- Hero-блок первого экрана -------------------------------------------------------- */
.hero { display: block; margin-bottom: 18px; }
.hero h2 { font-size: 32px; }
.hero h2 em { color: #ff5a3c; font-style: normal; }
.formula { display: block; margin: 4px 0px 0px 0px; color: #ffb03a; font-size: 13px; letter-spacing: 1px; }
.cols { display: flex; flex-direction: row; }
.cols > .col { flex: 1 1 0; min-width: 0px; margin-right: 16px; }
.cols > .col:last-child { margin-right: 0px; }
