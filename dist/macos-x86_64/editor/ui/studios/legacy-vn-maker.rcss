.vnm-row { width:100%; height:86%; display:flex; flex-direction:row; }
.vnm-side { width:22%; padding:8px; box-sizing:border-box; overflow:auto; border-width:1px; border-color:#223149; }
.vnm-left { border-right-width:1px; }
.vnm-right { width:26%; border-left-width:1px; }
.vnm-main { flex:1; min-width:40%; padding:8px; box-sizing:border-box; display:flex; flex-direction:column; }
.vnm-list { display:block; margin-bottom:8px; }
.vnm-item { display:block; padding:4px 6px; margin:2px 0; background-color:#0d1727; color:#cfe1ff; }
.vnm-item.active { background-color:#24446f; color:#ffffff; }
.vnm-item .vnm-kind { color:#7fa6d8; font-size:12px; }
.vnm-commands { flex:1; overflow:auto; display:block; }
.vnm-cmd { display:block; padding:5px 6px; margin:2px 0; background-color:#0c1626; border-left-width:3px; border-color:#2f5a8a; }
.vnm-cmd.active { background-color:#1b3556; border-color:#ffb3d9; }
.vnm-cmd .vnm-head { color:#8fd0ff; }
.vnm-cmd .vnm-body { color:#dbe7f7; white-space:pre-wrap; }
.vnm-source { flex:1; display:block; background-color:#08101c; color:#dbe7f7; border-width:1px; border-color:#2b4366; }
.vnm-diag { display:block; max-height:160px; overflow:auto; }
.vnm-diag .diag { display:block; margin:2px 0; font-size:12px; }
.vnm-scene-name { color:#ffb3d9; }
.field-row { display:block; margin:3px 0; }
.vnm-graph { display:block; }
.vnm-node { position:absolute; display:block; padding:4px; background-color:#10213a; border-width:1px; border-color:#3b6ea5; color:#dbe7f7; }
.vnm-edge { position:absolute; display:block; height:2px; background-color:#5f8fc4; transform-origin:left center; }
