/* SpriteMesh во вкладке Editor (поверх hammer.rcss: общие hm-* классы). */

.sm-center { display: flex; flex-direction: column; flex: 1 1 0; min-width: 0px; background-color: transparent; }
.sm-viewbar > * { flex: 0 0 auto; }
.sm-viewbar .we-spacer { flex: 1 1 0; }
.sm-mode { width: 150px; padding: 3px 6px; height: 16px; }
/* Вид прозрачный: под ним кадр сцены с мешем ($.spriteMesh.draw). */
.sm-view { display: block; flex: 1 1 0; min-height: 0px; background-color: transparent; cursor: move; }
.sm-hud { display: block; flex: 0 0 auto; padding: 3px 10px; font-size: 12px; color: #8b93a3; background-color: #14161b; }

.sm-anim { display: block; flex: 0 0 auto; padding: 6px 10px; background-color: #1b1e24; border-top: 1px #2a2f39; }
.sm-anim-row { display: flex; flex-direction: row; align-items: center; margin: 3px 0px; }
.sm-anim-row > * { flex: 0 0 auto; }
.sm-anim-row .we-spacer { flex: 1 1 0; }
.sm-anim-title { color: #e6e9ef; font-size: 14px; margin-right: 12px; }
.sm-tags { display: flex; flex-direction: row; }
.sm-tags .item {
    display: inline-block; width: auto; padding: 4px 12px; margin-right: 4px; font-size: 12px; color: #c9ced8; cursor: pointer;
    background-color: #262a33; border-width: 1px; border-color: #343a46; border-radius: 4px;
}
.sm-tags .item.on { color: #ffffff; background-color: #2563eb; border-color: #3b82f6; }
.sm-anim-select { width: 140px; padding: 3px 6px; height: 16px; }

.sm-strip { display: block; height: 96px; overflow-x: auto; overflow-y: hidden; white-space: nowrap; padding: 4px 0px; }
.sm-strip .item.thumb {
    display: inline-block; width: 72px; height: 82px; margin-right: 6px; padding: 2px; vertical-align: top; text-align: center;
    background-color: #14161b; border-width: 1px; border-color: #2f3440; border-radius: 4px; cursor: pointer;
}
.sm-strip .item.thumb.on { border-color: #3b82f6; background-color: #1f3a5f; }
.thumb-img { display: block; width: 64px; height: 64px; margin: 0px auto; }
.thumb-n { display: block; font-size: 11px; color: #8b93a3; }

.sm-right .hm-insp { flex: 1 1 0; }
.sm-file { display: block; flex: 1 1 0; color: #d7dce6; font-size: 12px; white-space: nowrap; overflow: hidden; }
.sm-stats { display: block; font-size: 12px; color: #c3c9d4; line-height: 18px; }
.sm-errors { display: block; color: #f14c4c; font-size: 12px; margin-top: 6px; }
.sm-footer { display: block; flex: 0 0 auto; padding: 8px 10px; border-top: 1px #2a2f39; }
.sm-cache { display: block; margin: 6px 0px 2px 0px; }
.sm-state { color: #4ad991; font-size: 13px; }
.sm-note { display: block; font-size: 11px; color: #6b7280; }
