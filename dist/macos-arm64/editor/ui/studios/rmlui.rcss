/* RmlUi: вьюпорт прозрачный — поверх него встаёт настоящий документ-черновик. */
.rm-conflict { display: flex; position: absolute; z-index: 80; left: 0px; top: 0px; width: 100%; height: 100%; align-items: center; justify-content: center; }
.rm-conflict-shade { display: block; position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; background-color: rgba(4, 6, 10, 180); }
.rm-conflict-card { display: block; position: relative; width: 540px; max-width: 90%; padding: 20px; background-color: #20242b; border-width: 1px; border-color: #4a5260; border-radius: 8px; }
.rm-conflict-title { display: block; color: #f0f2f6; font-size: 17px; }
.rm-conflict-message { display: block; margin-top: 10px; color: #b8bec9; white-space: normal; }
.rm-conflict-path { display: block; max-height: 110px; overflow-y: auto; margin-top: 8px; color: #9dc9ff; font-family: Roboto Mono; white-space: normal; }
.rm-conflict-actions { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 18px; }
.rm-conflict-actions .st-btn { margin: 0px 6px 4px 0px; }
.rm-view { border: 1px #2a2f39; }
.rm-src-bar { display: flex; flex-direction: row; align-items: center; flex: 0 0 auto; padding: 4px 10px; background-color: #1b1e24; border-top: 1px #2a2f39; }
textarea.rm-src { flex: 0 0 auto; height: 150px; margin: 0px; border-radius: 0px; font-family: Roboto Mono; }
textarea.rm-rcss { height: 180px; font-family: Roboto Mono; }
.rm-node .rm-tag { color: #7dd3fc; }
.rm-node .rm-id { color: #fbbf24; margin-left: 4px; }
.rm-node .rm-cls { color: #a78bfa; margin-left: 4px; }
.rm-node .rm-txt { color: #8b93a3; margin-left: 6px; }
