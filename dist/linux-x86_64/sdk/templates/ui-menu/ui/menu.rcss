body { font-family: Open Sans; color: #e9edf6; width: 100%; height: 100%; }
#menu { display: block; width: 360px; margin: 160px auto 0 auto; padding: 28px; background-color: #141926; border-radius: 14px; }
h1 { display: block; font-size: 32px; margin-bottom: 18px; }
.btn { display: block; margin: 8px 0; padding: 10px 16px; background-color: #1a2030; border-radius: 10px; }
.btn:hover { background-color: #232b3d; }
.btn:active { background-color: #0f131c; }
#status { color: #ffb03a; margin-top: 12px; }
