/* Сплэш SDK: виден, пока грузятся реестр/расширения/версия. Только RmlUi. */
body { display: block; margin: 0px; padding: 0px; width: 100%; height: 100%; background-color: #0b0e14; font-family: Open Sans; font-size: 15px; color: #e9edf6; }
.splash { display: block; position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; z-index: 900; }
.splash-img { display: block; position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; z-index: 901; }
.splash-shade { display: block; position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; z-index: 902; background-color: rgba(8, 11, 18, 120); }
.splash-panel {
    display: block; position: absolute; z-index: 903; left: 54px; bottom: 48px; width: 760px;
    padding: 24px 28px 20px 28px;
    background-color: rgba(11, 14, 20, 225);
    border-radius: 14px; border-width: 1px; border-color: #2b3550;
}
.splash-kicker { display: block; font-size: 12px; color: #ffb03a; letter-spacing: 3px; margin-bottom: 10px; }
.splash-title { display: block; font-size: 26px; color: #e9edf6; letter-spacing: 1px; margin-bottom: 16px; }
.splash-stage { display: block; font-size: 13px; color: #97a2b8; margin-bottom: 10px; }
.splash-track { display: block; width: 100%; height: 10px; background-color: #1a2030; border-radius: 5px; border-width: 1px; border-color: #232b3d; }
.splash-bar { display: block; width: 100%; height: 10px; border-radius: 5px; }
.splash-fill { display: block; height: 10px; width: 0%; background-color: #ff5a3c; border-radius: 5px; }
.splash-meta { display: block; margin-top: 8px; font-size: 12px; color: #7b87a0; }
#splash-percent { color: #e9edf6; letter-spacing: 1px; }
#splash-version { margin-left: 14px; color: #7b87a0; }
