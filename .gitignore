.zwork/
.dsh/
sdk/state.local.json

# Сайт (site/) не хранится в git вообще: он публикуется отдельно и содержит
# доступы к хостингу. Файлы остаются на диске.
# Прогресс, который game_test пишет в свой файл: не часть репозитория.
build/test_game_save_*.json

# Graphify generated graph/cache (local tooling)
graphify-out/

