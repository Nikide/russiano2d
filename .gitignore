# --- Build output ---
build/
build-*/
out/
bin/
# dist/ СОЗНАТЕЛЬНО не игнорируется: готовые сборки раздаются прямо из
# репозитория (их кладёт tools/autobuild.py или локальный build_and_push.sh).
#
# dist-ci/ — каталог сборки CI на GitVerse (.gitverse/workflows/release.yaml).
# Он тоже собирается в архив, но это временный артефакт прогона: в репозиторий
# ему нельзя, иначе build_and_push.sh затащит его через `git add -A`.
dist-ci/
dist-ci-*/
save.json
# Прогресс демо-новеллы: у неё свой файл, чтобы не путаться с save.json игры.
demos/vn_save.json
cmake-build-*/
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.pdb

# --- CMake ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
_deps/
compile_commands.json

# --- Generated shader / bytecode artifacts ---
src/generated/
*.spv
*.metallib
*.dxil
qjsc_out/

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --- Logs / runtime ---
*.log
imgui.ini
__pycache__/

# Локальный скрипт автосборки и публикации (только на этой машине)
build_and_push.sh
build_and_push.log

# site/ — наш собственный сайт движка. Делаем его локально и в репозиторий
# не пускаем: он собирается/публикуется отдельно. Там же лежат доступы к
# хостингу (site/.env.deploy) — поэтому site/ игнорируется целиком.
site/

# --- Секреты / доступы: в публичный репозиторий не попадает НИКОГДА ---
.env
.env.*
*.env
secrets/
*.secret
*.pem
*.key
id_rsa*
*.ppk
.ftpconfig
.vscode/sftp.json

# В dist/ лежат готовые пакеты, и там нужны файлы, которые обычно собираются
# на месте: исполняемые (.exe) и библиотеки рядом с бинарником (.dylib/.so).
# Без этих исключений из репозитория пропадали windows-russiano2d.exe и весь
# каталог lib/ в macOS-пакете.
!dist/**/*.exe
!dist/**/*.dll
!dist/**/*.dylib
!dist/**/*.so
!dist/**/*.so.*
