# --- Build output ---
build/
build-*/
out/
bin/
# dist/ СОЗНАТЕЛЬНО не игнорируется: CI на hub.mos.ru не работает, поэтому
# готовые сборки раздаются прямо из репозитория (их кладёт tools/autobuild.py
# или локальный build_and_push.sh).
save.json
cmake-build-*/
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.pdb

# --- CMake ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
_deps/
compile_commands.json

# --- Generated shader / bytecode artifacts ---
src/generated/
*.spv
*.metallib
*.dxil
qjsc_out/

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --- Logs / runtime ---
*.log
imgui.ini
__pycache__/

# Локальный скрипт автосборки и публикации (только на этой машине)
build_and_push.sh
build_and_push.log

# В dist/ лежат готовые пакеты, и там нужны файлы, которые обычно собираются
# на месте: исполняемые (.exe) и библиотеки рядом с бинарником (.dylib/.so).
# Без этих исключений из репозитория пропадали windows-russiano2d.exe и весь
# каталог lib/ в macOS-пакете.
!dist/**/*.exe
!dist/**/*.dll
!dist/**/*.dylib
!dist/**/*.so
!dist/**/*.so.*
