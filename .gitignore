src/generated/
*.spv
*.metallib
*.dxil
qjsc_out/

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --- Logs / runtime ---
*.log
imgui.ini
__pycache__/
*.py[cod]
*.cleanup.tmp

# Локальный лог выпуска.
build_and_push.log

# site/ — наш собственный сайт движка. Делаем его локально и в репозиторий
# не пускаем: он собирается/публикуется отдельно. Там же лежат доступы к
# хостингу (site/.env.deploy) — поэтому site/ игнорируется целиком.
site/

# Локальные сценарии выпуска и публикации сайта остаются на машине.
push_and_deploy.sh
# .command — версия для двойного клика в Finder (macOS); .sh оставлен для
# старых копий на других машинах, чтобы они тоже не попали в git.
build_and_push.sh
build_and_push.command
build_and_push
build-xmake/

# «к удалению/» и «отклонено/» — личные каталоги разбора: что-то вынесено из
# проекта, что-то отложено. Историю хранит git, таскать это в каждом клоне
# незачем.
к удалению/
отклонено/

# Состояние сохранений, которое пишут тесты (fixtures/saves, slot-*): это
# артефакты прогона, а не данные проекта.
saves/

# --- Секреты / доступы: в публичный репозиторий не попадает НИКОГДА ---
.env
.env.*
*.env
secrets/
*.secret
*.pem
*.key
id_rsa*
*.ppk
.ftpconfig
.vscode/sftp.json

