# ===========================================================================
# CI для hub.mos.ru (GitLab): взять архивы из dist/ и положить их в релиз.
#
# СБОРКИ ЗДЕСЬ НЕТ. Движок собирается локально на маке (tools/autobuild.py),
# архивы коммитятся в dist/ вместе с тегом — эта job'а только публикует.
#
# НИКАКИХ СЕКРЕТОВ: релиз создаёт штатный release-cli, авторизация — встроенный
# CI_JOB_TOKEN. Ни ключей, ни переменных заводить не нужно.
#
# Образ нужен ровно один и только потому, что в нём лежит release-cli; никакие
# пакеты не ставятся, ничего не компилируется, файлы не переупаковываются.
#
# Ссылки ведут на файлы тега в репозитории (dist/ уже в нём) — то есть на то,
# что собрано на маке, без промежуточных артефактов CI.
#
# Триггер: тег вида v0.2.0 (`git push origin v0.2.0`) или ручной запуск.
# ===========================================================================

publish:
  stage: release
  image: registry.gitlab.com/gitlab-org/release-cli:latest
  rules:
    - if: '$CI_COMMIT_TAG =~ /^v[0-9]+\.[0-9]+\.[0-9]+$/'
  script:
    - echo "Публикую архивы из dist/ тега $CI_COMMIT_TAG"
    - ls -la dist/*.tar.gz dist/*.zip dist/SHA256SUMS.txt
  release:
    tag_name: "$CI_COMMIT_TAG"
    name: "Russiano2D $CI_COMMIT_TAG"
    description: |
      Сборки Russiano2D $CI_COMMIT_TAG — файлы из `dist/` этого тега.

      Внутри архива: движок, игра по умолчанию (`game/`, `assets/`),
      документация (`README.md`, `AGENTS.md`) и внешние библиотеки в `lib/`.

      Что нового — в [CHANGELOG.md]($CI_PROJECT_URL/-/blob/$CI_COMMIT_TAG/CHANGELOG.md).
      Собрать самому: `python3 tools/autobuild.py --help`.
    assets:
      links:
        - name: "macOS, Apple Silicon (.tar.gz)"
          url: "$CI_PROJECT_URL/-/raw/$CI_COMMIT_TAG/dist/russiano2d-macos-arm64.tar.gz"
          link_type: package
        - name: "Linux x86_64 (.tar.gz)"
          url: "$CI_PROJECT_URL/-/raw/$CI_COMMIT_TAG/dist/russiano2d-linux-x86_64.tar.gz"
          link_type: package
        - name: "Linux aarch64 (.tar.gz)"
          url: "$CI_PROJECT_URL/-/raw/$CI_COMMIT_TAG/dist/russiano2d-linux-aarch64.tar.gz"
          link_type: package
        - name: "Windows x86_64 (.zip)"
          url: "$CI_PROJECT_URL/-/raw/$CI_COMMIT_TAG/dist/russiano2d-windows-x86_64.zip"
          link_type: package
        - name: "SHA256SUMS.txt"
          url: "$CI_PROJECT_URL/-/raw/$CI_COMMIT_TAG/dist/SHA256SUMS.txt"
          link_type: other
