/* ---------------------------------------------------------------------------
   Russiano2D Editor — тема и раскладка (макеты: RUSSIANO2D_EDITOR_TZ.md).

     фон  #16181d   панель #1b1e24   панель-2 #21252d   линия #2a2f39
     текст #d7dce6  тусклый #8b93a3  акцент #3b82f6     запуск #2ea043
     код   #14161b  выделение #264f78  предупреждение #e2b33c  ошибка #f14c4c

   RmlUi не знает CSS-переменных — значения литералами. Любой overflow:auto
   обязан иметь стили полос прокрутки ниже, иначе RmlUi схлопывает детей.
   --------------------------------------------------------------------------- */

body {
    font-family: Open Sans;
    font-size: 14px;
    color: #d7dce6;
    width: 100%;
    height: 100%;
    /* Прозрачный: под вкладкой студии виден runtime-кадр (3D CAMERA Hammer).
       Остальные области закрыты своими фонами. */
    background-color: transparent;
}

scrollbarvertical { width: 10px; margin: 0px; }
scrollbarvertical slidertrack { background-color: transparent; }
scrollbarvertical sliderbar { width: 6px; margin: 0px 2px; background-color: #3a404c; border-radius: 3px; }
scrollbarvertical sliderbar:hover { background-color: #4d5564; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { width: 0px; height: 0px; }
scrollbarhorizontal { height: 10px; margin: 0px; }
scrollbarhorizontal slidertrack { background-color: transparent; }
scrollbarhorizontal sliderbar { height: 6px; margin: 2px 0px; background-color: #3a404c; border-radius: 3px; }
scrollbarhorizontal sliderarrowdec, scrollbarhorizontal sliderarrowinc { width: 0px; height: 0px; }
scrollbarcorner { background-color: transparent; }

.hidden { display: none; }
/* Правила с #id специфичнее .hidden — скрываемым блокам нужен свой селектор. */
#pm.hidden, #app.hidden, #palette.hidden, #findbar.hidden, #code.hidden, #pane.hidden, #welcome.hidden,
#sidebar.hidden, #side-search.hidden, #caret.hidden, #code-vscroll.hidden { display: none; }
.icon { font-size: 18px; }
.muted { color: #8b93a3; }
.grow { flex: 1 1 0; }

/* --- Каркас ---------------------------------------------------------------- */
#app { display: flex; flex-direction: column; width: 100%; height: 100%; }

#topbar {
    display: flex; flex-direction: row; align-items: center;
    height: 44px; flex: 0 0 44px; padding: 0px 10px;
    background-color: #1b1e24; border-bottom: 1px #2a2f39;
}
.tb-btn {
    display: inline-block; padding: 5px 9px; margin-right: 4px; color: #c3c9d4;
    border-radius: 6px; cursor: pointer;
}
.tb-btn:hover { background-color: #2a2f39; color: #ffffff; }
.tb-btn.disabled { color: #4f5664; }
#tb-project { font-size: 15px; color: #e6e9ef; padding: 5px 10px; margin-right: 14px; }
#tb-search {
    display: block; flex: 1 1 0; max-width: 560px; margin: 0px auto;
    padding: 6px 12px; color: #8b93a3; background-color: #121418;
    border-width: 1px; border-color: #2f3440; border-radius: 6px; cursor: pointer;
}
#tb-search:hover { border-color: #4a5160; }
.run-btn {
    display: inline-block; padding: 6px 16px; margin-left: 6px; border-radius: 6px; cursor: pointer;
    color: #ffffff; background-color: #238636; border-width: 1px; border-color: #2ea043;
}
.run-btn:hover { background-color: #2ea043; }
.run-btn.running { background-color: #1f4d2b; color: #9be3ad; }
.stop-btn {
    display: inline-block; padding: 6px 14px; margin-left: 6px; border-radius: 6px; cursor: pointer;
    color: #c3c9d4; background-color: #262a33; border-width: 1px; border-color: #343a46;
}
.stop-btn:hover { background-color: #30353f; }
.stop-btn.disabled { color: #4f5664; }

#main { display: flex; flex-direction: row; flex: 1 1 0; min-height: 0px; }

#rail {
    display: flex; flex-direction: column; align-items: center;
    width: 48px; flex: 0 0 48px; padding-top: 6px;
    background-color: #1b1e24; border-right: 1px #2a2f39;
}
.rail-btn {
    display: block; width: 36px; height: 36px; margin: 3px 0px; line-height: 36px; text-align: center;
    font-size: 21px; color: #7d8594; border-radius: 6px; cursor: pointer;
}
.rail-btn:hover { color: #e6e9ef; }
.rail-btn.on { color: #e6e9ef; border-left: 2px #3b82f6; }

#sidebar {
    display: flex; flex-direction: column; width: 270px; flex: 0 0 270px;
    background-color: #1b1e24; border-right: 1px #2a2f39;
}
.side-title {
    display: block; flex: 0 0 auto; padding: 10px 14px 8px 14px;
    font-size: 13px; color: #c3c9d4;
}
.side-body { display: block; flex: 1 1 0; overflow-y: auto; padding-bottom: 12px; }

.tree-row {
    display: block; height: 24px; line-height: 24px; padding-right: 8px; white-space: nowrap;
    font-size: 13px; color: #c9ced8; cursor: pointer;
}
.tree-row:hover { background-color: #23272f; }
.tree-row.sel { background-color: #1f3a5f; color: #ffffff; }
.tree-row.open-file { color: #ffffff; }
.tree-ico { display: inline-block; width: 18px; font-size: 15px; color: #8b93a3; }
.tree-ico.js { color: #e8c547; }
.tree-ico.json { color: #e8a547; }
.tree-ico.img { color: #b083f0; }
.tree-ico.folder { color: #8b93a3; }
.tree-ico.studio { color: #4fb3ff; }

/* --- Центр: вкладки и хост --------------------------------------------------- */
#center { display: flex; flex-direction: column; flex: 1 1 0; min-width: 0px; background-color: #14161b; }
#center.studio-on { background-color: transparent; }
#inspector.hidden { display: none; }
#tabs {
    display: flex; flex-direction: row; height: 36px; flex: 0 0 36px;
    background-color: #1b1e24; border-bottom: 1px #2a2f39; overflow: hidden;
}
.tab {
    display: inline-block; height: 36px; line-height: 36px; padding: 0px 10px 0px 12px;
    font-size: 13px; color: #9aa2b1; border-right: 1px #2a2f39; cursor: pointer; white-space: nowrap;
}
.tab:hover { background-color: #20242b; }
.tab.on { color: #ffffff; background-color: #14161b; border-top: 2px #3b82f6; }
.tab-ico { display: inline-block; width: 18px; font-size: 14px; }
.tab-x { display: inline-block; width: 18px; margin-left: 6px; text-align: center; color: #6b7280; border-radius: 4px; }
.tab-x:hover { color: #ffffff; background-color: #343a46; }
.tab-dirty { color: #e6e9ef; font-size: 10px; }

#host { display: block; position: relative; flex: 1 1 0; min-height: 0px; }
.welcome { display: block; padding: 60px 40px; color: #8b93a3; text-align: center; }
.welcome h1 { display: block; font-size: 26px; color: #d7dce6; margin-bottom: 10px; }
.welcome .keys { display: block; margin-top: 18px; font-size: 13px; line-height: 24px; }
.kbd { color: #c3c9d4; background-color: #23272f; padding: 1px 6px; border-radius: 4px; }

/* --- Редактор кода ------------------------------------------------------------ */
#code {
    display: block; position: absolute; left: 0px; top: 0px; right: 0px; bottom: 0px;
    font-family: Roboto Mono; font-size: 13px; background-color: #14161b;
    overflow: hidden; cursor: text;
}
#code-gutter {
    display: block; position: absolute; left: 0px; top: 0px; bottom: 0px; width: 56px;
    color: #4b5263; text-align: right; background-color: #14161b;
}
#code-text { display: block; position: absolute; left: 64px; top: 0px; right: 0px; bottom: 0px; overflow: hidden; }
.ln { display: block; position: absolute; left: 0px; right: 8px; height: 20px; line-height: 20px; }
.ln.cur { color: #c3c9d4; }
.ln.err { color: #f14c4c; }
.ln.warn { color: #e2b33c; }
.cl {
    display: block; position: absolute; left: 0px; height: 20px; line-height: 20px;
    white-space: pre; color: #d7dce6;
}
.cur-line { display: block; position: absolute; left: 0px; right: 0px; height: 20px; background-color: #1c1f26; }
.sel-rect { display: block; position: absolute; height: 20px; background-color: #264f78; }
.find-rect { display: block; position: absolute; height: 20px; background-color: #5a4a1a; }
.diag-line { display: block; position: absolute; height: 2px; background-color: #f14c4c; }
.diag-line.warn { background-color: #e2b33c; }
#caret { display: block; position: absolute; width: 2px; height: 18px; background-color: #e6e9ef; }
#caret.blink { background-color: transparent; }
#code-measure { display: block; position: absolute; left: -9000px; top: 0px; white-space: pre; }
#code-vscroll {
    display: block; position: absolute; right: 2px; width: 6px; border-radius: 3px; background-color: #3a404c;
}

/* Подсветка — тема как у VS Code Dark+ */
.tk-kw { color: #c586c0; }
.tk-str { color: #ce9178; }
.tk-num { color: #b5cea8; }
.tk-com { color: #6a9955; }
.tk-lit { color: #569cd6; }
.tk-fn { color: #dcdcaa; }
.tk-key { color: #9cdcfe; }
.tk-dollar { color: #4fc1ff; }
.tk-punct { color: #a9b1bd; }

/* Поиск внутри файла */
#findbar {
    display: flex; flex-direction: row; align-items: center; position: absolute; top: 6px; right: 18px;
    padding: 5px 8px; background-color: #23272f; border-width: 1px; border-color: #343a46; border-radius: 6px;
    font-family: Open Sans;
}
#findbar input { width: 200px; margin-right: 6px; }
#find-count { display: inline-block; width: 70px; color: #8b93a3; font-size: 12px; }

/* --- Просмотр изображения и прочие вкладки ---------------------------------- */
.pane { display: block; position: absolute; left: 0px; top: 0px; right: 0px; bottom: 0px; overflow: auto; padding: 18px; }
.img-view { display: block; text-align: center; padding: 20px; }
.info-line { display: block; color: #8b93a3; margin-top: 10px; font-size: 13px; }

/* --- Инспектор ----------------------------------------------------------------- */
#inspector {
    display: flex; flex-direction: column; width: 300px; flex: 0 0 300px;
    background-color: #1b1e24; border-left: 1px #2a2f39;
}
.insp-path { display: block; padding: 0px 14px 10px 14px; font-size: 12px; color: #8b93a3; border-bottom: 1px #2a2f39; }
.insp-sec { display: block; padding: 10px 14px 4px 14px; }
.insp-label { display: block; font-size: 12px; color: #8b93a3; margin-bottom: 4px; }
.insp-value {
    display: block; padding: 6px 10px; margin-bottom: 8px; font-size: 13px; color: #d7dce6;
    background-color: #14161b; border-width: 1px; border-color: #2f3440; border-radius: 5px;
}
.insp-row { display: flex; flex-direction: row; align-items: center; }
.insp-row .insp-value { flex: 1 1 0; margin-right: 6px; }
.insp-note { display: block; font-size: 12px; color: #6b7280; margin-bottom: 8px; }

/* --- Нижняя панель ----------------------------------------------------------- */
#bottom {
    display: flex; flex-direction: column; height: 190px; flex: 0 0 190px;
    background-color: #1b1e24; border-top: 1px #2a2f39;
}
#bottom.collapsed { height: 34px; flex: 0 0 34px; }
#bottom-tabs { display: flex; flex-direction: row; align-items: center; height: 34px; flex: 0 0 34px; padding: 0px 8px; }
.btab { display: inline-block; padding: 7px 12px; font-size: 13px; color: #9aa2b1; cursor: pointer; }
.btab:hover { color: #e6e9ef; }
.btab.on { color: #ffffff; border-bottom: 2px #3b82f6; }
.badge {
    display: inline-block; min-width: 10px; padding: 0px 5px; margin-left: 6px; font-size: 11px; line-height: 16px;
    text-align: center; color: #ffffff; background-color: #c93c3c; border-radius: 8px;
}
.badge.zero { background-color: #3a404c; }
#bottom-body { display: block; flex: 1 1 0; overflow-y: auto; }
#bottom.collapsed #bottom-body { display: none; }
.prob-head, .prob {
    display: flex; flex-direction: row; height: 26px; line-height: 26px; padding: 0px 12px; font-size: 13px;
}
.prob-head { color: #8b93a3; border-bottom: 1px #2a2f39; }
.prob { cursor: pointer; }
.prob:hover { background-color: #23272f; }
.prob .c-type, .prob-head .c-type { width: 34px; flex: 0 0 34px; }
.prob .c-msg, .prob-head .c-msg { flex: 1 1 0; white-space: nowrap; overflow: hidden; }
.c-code { width: 230px; flex: 0 0 230px; margin-right: 10px; color: #8b93a3; white-space: nowrap; overflow: hidden; }
.c-file { width: 220px; flex: 0 0 220px; color: #4fa3ff; white-space: nowrap; overflow: hidden; }
.c-num { width: 56px; flex: 0 0 56px; text-align: right; color: #8b93a3; }
.sev-error { color: #f14c4c; }
.sev-warning { color: #e2b33c; }
.sev-info { color: #4fa3ff; }
.log { display: block; padding: 6px 12px; font-family: Roboto Mono; font-size: 12px; white-space: pre; color: #c3c9d4; }
.empty { display: block; padding: 10px 14px; color: #6b7280; font-size: 13px; }

#statusbar {
    display: flex; flex-direction: row; align-items: center; height: 26px; flex: 0 0 26px; padding: 0px 12px;
    font-size: 12px; color: #9aa2b1; background-color: #1b1e24; border-top: 1px #2a2f39;
}
.st { display: inline-block; margin-right: 16px; }
.st.right { margin-right: 0px; margin-left: 16px; }
.st.ok { color: #4ad991; }
.st.err { color: #f14c4c; }

/* --- Палитра команд / Quick Open ---------------------------------------------- */
#palette {
    display: block; position: absolute; top: 48px; left: 50%; width: 620px; margin-left: -310px;
    background-color: #23272f; border-width: 1px; border-color: #3a404c; border-radius: 8px;
}
#palette-input {
    display: block; width: 588px; margin: 8px; padding: 6px 8px; color: #e6e9ef;
    background-color: #14161b; border-width: 1px; border-color: #3b82f6; border-radius: 4px;
}
#palette-list { display: block; max-height: 360px; overflow-y: auto; padding-bottom: 6px; }
.pal-row { display: flex; flex-direction: row; height: 28px; line-height: 28px; padding: 0px 12px; cursor: pointer; font-size: 13px; }
.pal-row:hover { background-color: #2c313b; }
.pal-row.sel { background-color: #1f3a5f; }
.pal-label { flex: 1 1 0; color: #e6e9ef; white-space: nowrap; overflow: hidden; }
.pal-detail { color: #8b93a3; margin-left: 12px; white-space: nowrap; }
.pal-hit { color: #4fa3ff; }

/* --- Project Manager ----------------------------------------------------------- */
#pm { display: flex; flex-direction: column; width: 100%; height: 100%; background-color: #14161b; }
#pm-top { display: flex; flex-direction: row; align-items: center; padding: 28px 48px 20px 48px; border-bottom: 1px #23272f; }
#pm-logo {
    display: block; width: 44px; height: 44px; line-height: 44px; text-align: center; margin-right: 14px;
    border-radius: 10px; background-color: #2563eb; color: #ffffff; font-size: 26px;
}
.pm-brand { display: block; }
.pm-name { display: block; font-size: 22px; color: #e6e9ef; }
.pm-tag { display: block; font-size: 13px; color: #8b93a3; margin-top: 2px; }
#pm-body { display: flex; flex-direction: row; flex: 1 1 0; overflow: hidden; }
#pm-col-open { display: block; flex: 1 1 0; padding: 24px 40px 32px 48px; overflow-y: auto; }
#pm-col-new {
    display: block; width: 430px; flex: 0 0 430px; padding: 24px 32px 32px 32px; overflow-y: auto;
    background-color: #191c22; border-left: 1px #23272f;
}
.pm-sec-head { display: flex; flex-direction: row; align-items: center; margin: 4px 0px 10px 0px; }
.pm-sec-title { display: block; font-size: 15px; color: #e6e9ef; margin-bottom: 10px; }
.pm-sec-head .pm-sec-title { margin-bottom: 0px; }
.pm-count { display: block; margin-left: 8px; padding: 1px 7px; font-size: 11px; color: #9aa3b2; background-color: #23272f; border-radius: 8px; }
#pm-recent { display: block; margin-bottom: 26px; }
.pm-row {
    display: flex; flex-direction: row; align-items: center; padding: 10px 12px; margin-bottom: 6px; cursor: pointer;
    border-radius: 8px; background-color: #1b1e24; border-width: 1px; border-color: #262a33;
}
.pm-row:hover { border-color: #3b82f6; background-color: #1e222a; }
.pm-row.missing { cursor: default; }
.pm-row.missing:hover { border-color: #262a33; background-color: #1b1e24; }
.pm-row.missing .pm-title, .pm-row.missing .pm-ico { color: #5d6472; }
.pm-ico {
    display: block; width: 34px; height: 34px; line-height: 34px; text-align: center; flex: 0 0 34px;
    margin-right: 12px; border-radius: 7px; background-color: #23272f; color: #7aa7ff; font-size: 20px;
}
.pm-info { display: block; flex: 1 1 0; overflow: hidden; }
.pm-title { display: block; color: #e6e9ef; }
.pm-path { display: block; font-size: 12px; color: #7b8494; margin-top: 2px; white-space: nowrap; overflow: hidden; }
.pm-badge { display: block; margin-left: 8px; padding: 1px 7px; font-size: 11px; border-radius: 8px; color: #9aa3b2; background-color: #23272f; }
.pm-badge.warn { color: #e2b65b; background-color: #2e2818; }
.pm-x {
    display: block; width: 26px; height: 26px; line-height: 26px; text-align: center; flex: 0 0 26px; margin-left: 8px;
    border-radius: 5px; color: #6b7280; font-size: 16px; cursor: pointer;
}
.pm-x:hover { color: #e6e9ef; background-color: #30353f; }
.pm-open { display: inline-block; margin-left: 0px; padding: 8px 16px; }
.pm-dirbar { display: flex; flex-direction: row; align-items: center; }
.pm-dir {
    display: block; flex: 1 1 0; padding: 6px 10px; color: #c9cfda; background-color: #14161b; font-size: 13px;
    border-width: 1px; border-color: #2f3440; border-radius: 5px; white-space: nowrap; overflow: hidden;
}
.pm-hint { display: block; font-size: 12px; color: #6b7280; margin-top: 6px; }
.pm-step { display: block; font-size: 12px; letter-spacing: 1px; color: #8b93a3; margin: 16px 0px 8px 0px; }
#pm-templates { display: block; }
.pm-tpl {
    display: flex; flex-direction: row; align-items: center; padding: 8px 10px; margin-bottom: 6px; cursor: pointer;
    border-radius: 8px; background-color: #1f232b; border-width: 1px; border-color: #2a2f39;
}
.pm-tpl:hover { border-color: #3b82f6; }
.pm-tpl.selected { border-color: #3b82f6; background-color: #1d2a44; }
.pm-tpl.selected .pm-ico { background-color: #2563eb; color: #ffffff; }
.pm-tpl-name { display: block; color: #e6e9ef; font-size: 14px; }
.pm-tpl-desc { display: block; color: #7b8494; font-size: 11px; margin-top: 2px; }
.pm-dest { display: block; font-size: 12px; color: #8b93a3; margin-top: 8px; word-break: break-all; }
.pm-dest.bad { color: #e2b65b; }
.pm-create { display: block; width: 100%; box-sizing: border-box; margin: 18px 0px 0px 0px; margin-left: 0px; padding: 9px 14px; text-align: center; }
#pm-col-new .field { display: block; width: 100%; box-sizing: border-box; }
#pm .pm-openbar .field { flex: 1 1 0; }
.field {
    display: block; flex: 1 1 0; padding: 6px 10px; color: #e6e9ef; background-color: #14161b;
    border-width: 1px; border-color: #2f3440; border-radius: 5px; cursor: text;
}
.field:focus { border-color: #3b82f6; }
.form { display: flex; flex-direction: row; align-items: center; margin: 6px 0px; }
.btn {
    display: inline-block; padding: 6px 14px; margin-left: 8px; color: #e6e9ef; cursor: pointer;
    background-color: #262a33; border-width: 1px; border-color: #343a46; border-radius: 5px;
}
.btn:hover { background-color: #30353f; }
.btn.primary { background-color: #2563eb; border-color: #3b82f6; }
.btn.primary:hover { background-color: #3b82f6; }
.pm-err { display: block; color: #f14c4c; margin-top: 8px; font-size: 13px; }
#pm .pm-open, #pm .pm-create { margin-left: 0px; }
