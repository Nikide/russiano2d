/* ---------------------------------------------------------------------------
   Russiano2D Editor — тема и раскладка (макеты: RUSSIANO2D_EDITOR_TZ.md).

     фон  #16181d   панель #1b1e24   панель-2 #21252d   линия #2a2f39
     текст #d7dce6  тусклый #8b93a3  акцент #3b82f6     запуск #2ea043
     код   #14161b  выделение #264f78  предупреждение #e2b33c  ошибка #f14c4c

   RmlUi не знает CSS-переменных — значения литералами. Любой overflow:auto
   обязан иметь стили полос прокрутки ниже, иначе RmlUi схлопывает детей.
   --------------------------------------------------------------------------- */

body {
    font-family: Open Sans;
    font-size: 14px;
    color: #d7dce6;
    width: 100%;
    height: 100%;
    /* Прозрачный: под вкладкой студии виден runtime-кадр (3D CAMERA Hammer).
       Остальные области закрыты своими фонами. */
    background-color: transparent;
}

scrollbarvertical { width: 10px; margin: 0px; }
scrollbarvertical slidertrack { background-color: transparent; }
scrollbarvertical sliderbar { width: 6px; margin: 0px 2px; background-color: #3a404c; border-radius: 3px; }
scrollbarvertical sliderbar:hover { background-color: #4d5564; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { width: 0px; height: 0px; }
scrollbarhorizontal { height: 10px; margin: 0px; }
scrollbarhorizontal slidertrack { background-color: transparent; }
scrollbarhorizontal sliderbar { height: 6px; margin: 2px 0px; background-color: #3a404c; border-radius: 3px; }
scrollbarhorizontal sliderarrowdec, scrollbarhorizontal sliderarrowinc { width: 0px; height: 0px; }
scrollbarcorner { background-color: transparent; }

.hidden { display: none; }
/* Правила с #id специфичнее .hidden — скрываемым блокам нужен свой селектор. */
#pm.hidden, #app.hidden, #palette.hidden, #findbar.hidden, #code.hidden, #pane.hidden, #welcome.hidden,
#sidebar.hidden, #side-search.hidden, #caret.hidden, #code-sticky.hidden, #param-hint.hidden, #code-menu.hidden, #replace-row.hidden, #code-switch.hidden, #code-vscroll.hidden, #code-completion.hidden, #api-hover.hidden,
#close-confirm.hidden, #file-conflict.hidden, #file-conflict-reload.hidden, #gp.hidden, #gp-results.hidden, #gp-warn.hidden, #gp-empty.hidden { display: none; }
.icon { font-size: 18px; }
.muted { color: #8b93a3; }
.grow { flex: 1 1 0; }

/* --- Каркас ---------------------------------------------------------------- */
#app { display: flex; flex-direction: column; width: 100%; height: 100%; }

#topbar {
    display: flex; flex-direction: row; align-items: center;
    height: 44px; flex: 0 0 44px; padding: 0px 10px;
    background-color: #1b1e24; border-bottom: 1px #2a2f39;
}
.tb-btn {
    display: inline-block; padding: 5px 9px; margin-right: 4px; color: #c3c9d4;
    border-radius: 6px; cursor: pointer;
}
.tb-btn:hover { background-color: #2a2f39; color: #ffffff; }
.tb-btn.disabled { color: #4f5664; }
#tb-project { font-size: 15px; color: #e6e9ef; padding: 5px 10px; margin-right: 14px; }
#tb-search {
    display: block; flex: 1 1 0; max-width: 560px; margin: 0px auto;
    padding: 6px 12px; color: #8b93a3; background-color: #121418;
    border-width: 1px; border-color: #2f3440; border-radius: 6px; cursor: pointer;
}
#tb-search:hover { border-color: #4a5160; }
.run-btn {
    display: inline-block; padding: 6px 16px; margin-left: 6px; border-radius: 6px; cursor: pointer;
    color: #ffffff; background-color: #238636; border-width: 1px; border-color: #2ea043;
}
.run-btn:hover { background-color: #2ea043; }
.run-btn.running { background-color: #1f4d2b; color: #9be3ad; }
.stop-btn {
    display: inline-block; padding: 6px 14px; margin-left: 6px; border-radius: 6px; cursor: pointer;
    color: #c3c9d4; background-color: #262a33; border-width: 1px; border-color: #343a46;
}
.stop-btn:hover { background-color: #30353f; }
.stop-btn.disabled { color: #4f5664; }

#main { display: flex; flex-direction: row; flex: 1 1 0; min-height: 0px; }

#rail {
    display: flex; flex-direction: column; align-items: center;
    width: 48px; flex: 0 0 48px; padding-top: 6px;
    background-color: #1b1e24; border-right: 1px #2a2f39;
}
.rail-btn {
    display: block; width: 36px; height: 36px; margin: 3px 0px; line-height: 36px; text-align: center;
    font-size: 21px; color: #7d8594; border-radius: 6px; cursor: pointer;
}
.rail-btn:hover { color: #e6e9ef; }
.rail-btn.on { color: #e6e9ef; border-left: 2px #3b82f6; }

#sidebar {
    display: flex; flex-direction: column; width: 270px; flex: 0 0 270px;
    background-color: #1b1e24; border-right: 1px #2a2f39;
}
.side-title {
    display: block; flex: 0 0 auto; padding: 10px 14px 8px 14px;
    font-size: 13px; color: #c3c9d4;
}
.side-body { display: block; flex: 1 1 0; overflow-y: auto; padding-bottom: 12px; }

.tree-row {
    display: block; height: 24px; line-height: 24px; padding-right: 8px; white-space: nowrap;
    font-size: 13px; color: #c9ced8; cursor: pointer;
}
.tree-row:hover { background-color: #23272f; }
.tree-row.sel { background-color: #1f3a5f; color: #ffffff; }
.tree-row.open-file { color: #ffffff; }
.tree-ico { display: inline-block; width: 18px; font-size: 15px; color: #8b93a3; }
.tree-ico.js { color: #e8c547; }
.tree-ico.json { color: #e8a547; }
.tree-ico.img { color: #b083f0; }
.tree-ico.folder { color: #8b93a3; }
.tree-ico.studio { color: #4fb3ff; }
.search-result { display: block; padding: 6px 10px; border-bottom: 1px #2a2f39; cursor: pointer; }
.search-result:hover { background-color: #23272f; }
.search-result-head { display: block; color: #9dc9ff; font-size: 12px; }
.search-result-head span { color: #d5aa65; }
.search-result-text { display: block; padding-top: 3px; color: #b8bec9; font-size: 12px; white-space: normal; }
.search-limit { padding: 8px 10px; color: #e1b964; font-size: 11px; }

/* --- Центр: вкладки и хост --------------------------------------------------- */
#center { display: flex; flex-direction: column; flex: 1 1 0; min-width: 0px; background-color: #14161b; }
#center.studio-on { background-color: transparent; }
#inspector.hidden { display: none; }
#tabs {
    display: flex; flex-direction: row; height: 36px; flex: 0 0 36px;
    background-color: #1b1e24; border-bottom: 1px #2a2f39; overflow: hidden;
}
.tab {
    display: inline-block; height: 36px; line-height: 36px; padding: 0px 10px 0px 12px;
    font-size: 13px; color: #9aa2b1; border-right: 1px #2a2f39; cursor: pointer; white-space: nowrap;
}
.tab:hover { background-color: #20242b; }
.tab.on { color: #ffffff; background-color: #14161b; border-top: 2px #3b82f6; }
.tab-ico { display: inline-block; width: 18px; font-size: 14px; }
.tab-x { display: inline-block; width: 18px; margin-left: 6px; text-align: center; color: #6b7280; border-radius: 4px; }
.tab-x:hover { color: #ffffff; background-color: #343a46; }
.tab-dirty { color: #e6e9ef; font-size: 10px; }

#host { display: block; position: relative; flex: 1 1 0; min-height: 0px; overflow: hidden; }
.welcome { display: block; padding: 60px 40px; color: #8b93a3; text-align: center; }
.welcome h1 { display: block; font-size: 26px; color: #d7dce6; margin-bottom: 10px; }
.welcome .keys { display: block; margin-top: 18px; font-size: 13px; line-height: 24px; }
.kbd { color: #c3c9d4; background-color: #23272f; padding: 1px 6px; border-radius: 4px; }

/* --- Редактор кода ------------------------------------------------------------ */
#code {
    display: block; position: absolute; left: 0px; top: 0px; right: 0px; bottom: 0px;
    font-family: Roboto Mono; font-size: 13px; background-color: #14161b;
    overflow: hidden; cursor: text;
}
#code-gutter {
    display: block; position: absolute; left: 0px; top: 24px; bottom: 0px; width: 56px;
    color: #4b5263; text-align: right; background-color: #14161b;
}
#code-text { display: block; position: absolute; left: 64px; top: 24px; right: 92px; bottom: 0px; overflow: hidden; }
.ln { display: block; position: absolute; left: 0px; right: 8px; height: 20px; line-height: 20px; }
.fold-toggle { display: block; font-size: 16px; position: absolute; left: 0px; width: 14px; height: 20px; color: #8992a2; text-align: center; cursor: pointer; }
.fold-toggle:hover { color: #e6e9ef; }
.fold-placeholder { margin-left: 8px; color: #8992a2; font-style: italic; }
.ln.cur { color: #c3c9d4; }
.ln.err { color: #f14c4c; }
.ln.warn { color: #e2b33c; }
.cl {
    display: block; position: absolute; left: 0px; height: 20px; line-height: 20px; overflow: hidden;
    white-space: nowrap; color: #d7dce6;
}
.cur-line { display: block; position: absolute; left: 0px; right: 0px; height: 20px; background-color: #1c1f26; }
.sel-rect { display: block; position: absolute; height: 20px; background-color: #264f78; }
.occ-rect { display: block; position: absolute; height: 20px; background-color: #2b3040; }
.indent-guide { display: block; position: absolute; width: 1px; height: 20px; background-color: #2a2e38; }
.find-rect { display: block; position: absolute; height: 20px; background-color: #5a4a1a; }
.bracket-match { display: block; position: absolute; height: 20px; box-sizing: border-box; border-width: 1px; border-color: #7b8497; background-color: #2a303b; }
.diag-line { display: block; position: absolute; height: 2px; background-color: #f14c4c; }
.diag-line.warn { background-color: #e2b33c; }
#caret { display: block; position: absolute; width: 2px; height: 18px; background-color: #e6e9ef; }
#caret.blink { background-color: transparent; }
#ime-preview { display: block; position: absolute; z-index: 2; min-width: 2px; height: 19px; line-height: 19px; white-space: pre; color: #ffffff; background-color: #303846; border-bottom: 2px #68baff; }
#ime-preview.hidden { display: none; }
#code-measure { display: block; position: absolute; left: -9000px; top: 0px; white-space: pre; }
#code-vscroll {
    display: block; position: absolute; right: 94px; width: 8px; border-radius: 4px; background-color: #3a404c; opacity: 0.7;
}
#code-vscroll:hover { background-color: #5a6272; }
#code-map { display: block; position: absolute; right: 0px; top: 24px; bottom: 0px; width: 90px; background-color: #171a20; border-left: 1px #232830; overflow: hidden; }
#code-map-lines { display: block; position: absolute; left: 0px; top: 0px; right: 0px; bottom: 0px; }
#code-map-slider { display: block; position: absolute; left: 0px; right: 0px; background-color: #4a5160; opacity: 0.28; }
.mm-l { display: block; position: absolute; height: 2px; background-color: #566072; }
.mm-c { display: block; position: absolute; height: 2px; background-color: #3c6a3c; }
.mm-m { display: block; position: absolute; right: 0px; width: 4px; height: 3px; }
.mm-e { background-color: #f14c4c; }
.mm-w { background-color: #e2b33c; }
.mm-f { background-color: #d7ba7d; }
.mm-s { background-color: #4f8cff; }
#crumbs {
    display: block; position: absolute; left: 0px; top: 0px; right: 0px; height: 24px; line-height: 24px; padding-left: 12px;
    font-family: Open Sans; font-size: 12px; color: #8b93a3; background-color: #14161b; border-bottom: 1px #20242c; overflow: hidden; white-space: nowrap;
}
.crumb { display: inline-block; cursor: pointer; }
.crumb:hover { color: #e6e9ef; }
.crumb-sep { display: inline-block; color: #4b5263; margin: 0px 2px; font-size: 14px; }
#code-sticky { display: block; position: absolute; z-index: 4; left: 0px; top: 24px; right: 92px; background-color: #14161b; border-bottom: 1px #2f3540; overflow: hidden; }
.sticky-row { display: block; position: absolute; left: 0px; right: 0px; height: 20px; cursor: pointer; }
.sticky-row:hover { background-color: #1c1f26; }
.sticky-ln { display: block; position: absolute; left: 0px; width: 48px; height: 20px; line-height: 20px; text-align: right; color: #4b5263; }
.sticky-code { display: block; position: absolute; left: 64px; right: 0px; height: 20px; line-height: 20px; overflow: hidden; white-space: nowrap; color: #d7dce6; }
.gm { display: block; position: absolute; right: 0px; width: 3px; height: 20px; }
.gm-add { background-color: #2ea043; }
.gm-mod { background-color: #3b82f6; }
.gm-del { height: 2px; width: 10px; background-color: #f14c4c; }
.xcaret { display: block; position: absolute; width: 2px; height: 18px; background-color: #e6e9ef; }
#carets-extra.blink .xcaret { background-color: transparent; }
.tk-b0 { color: #ffd700; }
.tk-b1 { color: #da70d6; }
.tk-b2 { color: #179fff; }
.tk-ws { color: #3a404c; }
#param-hint {
    display: block; position: absolute; z-index: 25; max-width: 560px; box-sizing: border-box; padding: 5px 10px;
    background-color: #20242b; border-width: 1px; border-color: #536071; border-radius: 5px; font-family: Roboto Mono; font-size: 12px; color: #c9ced8; white-space: nowrap;
}
#param-hint .ph-active { color: #ffffff; font-weight: bold; }
#param-hint .ph-doc { display: block; margin-top: 3px; font-family: Open Sans; color: #8b93a3; white-space: normal; }
#code-menu {
    display: block; position: absolute; z-index: 40; width: 250px; padding: 4px 0px; box-sizing: border-box;
    background-color: #23272f; border-width: 1px; border-color: #3a414e; border-radius: 6px; font-family: Open Sans; font-size: 13px;
}
.cm-item { display: flex; flex-direction: row; justify-content: space-between; height: 26px; line-height: 26px; padding: 0px 12px; color: #d7dce6; cursor: pointer; }
.cm-item:hover { background-color: #264f78; }
.cm-item.off { color: #5d6573; }
.cm-keys { display: block; color: #8b93a3; font-size: 12px; }
.cm-sep { display: block; height: 1px; margin: 4px 0px; background-color: #343a46; }
#code-completion {
    display: block; position: absolute; z-index: 20; width: 640px; max-height: 416px; overflow: hidden;
    box-sizing: border-box; background-color: #20242b; border-width: 1px; border-color: #454c58; border-radius: 5px;
    font-family: Open Sans; font-size: 13px;
}
#api-hover {
    display: block; position: absolute; z-index: 30; width: 520px; max-height: 240px; overflow: hidden;
    box-sizing: border-box; padding: 9px 11px; background-color: #20242b; border-width: 1px; border-color: #536071; border-radius: 5px;
}
.api-hover-title { display: block; color: #9cdcfe; font-family: Roboto Mono; font-size: 12px; }
.api-hover-signature { display: block; margin-top: 3px; color: #d7ba7d; font-family: Roboto Mono; font-size: 11px; }
.api-hover-description { display: block; margin-top: 5px; color: #c9ced8; font-size: 12px; white-space: normal; }
.api-completion-item { display: flex; flex-direction: row; align-items: center; height: 26px; padding-left: 10px; padding-right: 10px; }
.api-completion-item.selected { background-color: #264f78; }
.api-completion-name { display: block; flex: 0 0 160px; width: 160px; color: #9cdcfe; font-family: Roboto Mono; overflow: hidden; white-space: nowrap; }
.api-completion-signature { display: block; flex: 0 0 170px; width: 170px; color: #d7ba7d; font-family: Roboto Mono; overflow: hidden; white-space: nowrap; }
.api-completion-desc { display: block; flex: 1 1 0; color: #aab2c0; overflow: hidden; white-space: nowrap; }

/* Подсветка — тема как у VS Code Dark+ */
.tk-kw { color: #c586c0; }
.tk-str { color: #ce9178; }
.tk-num { color: #b5cea8; }
.tk-com { color: #6a9955; }
.tk-lit { color: #569cd6; }
.tk-fn { color: #dcdcaa; }
.tk-key { color: #9cdcfe; }
.tk-dollar { color: #4fc1ff; }
.tk-api-root { color: #4fc1ff; font-weight: bold; }
.tk-api-namespace { color: #9cdcfe; }
.tk-api { color: #4fc1ff; }
.tk-api-create { color: #4ec9b0; }
.tk-api-delete { color: #f14c4c; }
.tk-punct { color: #a9b1bd; }

/* Поиск внутри файла */
#findbar {
    display: flex; flex-direction: column; position: absolute; z-index: 6; top: 30px; right: 110px;
    padding: 5px 8px; background-color: #23272f; border-width: 1px; border-color: #343a46; border-radius: 6px;
    font-family: Open Sans;
}
.fb-row { display: flex; flex-direction: row; align-items: center; margin-bottom: 2px; }
#findbar input { width: 200px; margin-right: 6px; }
#find-count { display: inline-block; width: 70px; margin-left: 4px; color: #8b93a3; font-size: 12px; }
#find-count.bad { color: #f14c4c; }
.fb-opt { display: block; width: 24px; height: 22px; line-height: 22px; margin-right: 3px; text-align: center; border-radius: 4px; color: #aab2c0; font-size: 12px; cursor: pointer; }
.fb-opt.wide { width: 70px; margin-right: 6px; background-color: #2d333d; }
.fb-opt:hover { background-color: #343a46; }
.fb-opt.on { color: #ffffff; background-color: #264f78; }

/* --- Просмотр изображения и прочие вкладки ---------------------------------- */
.pane { display: block; position: absolute; left: 0px; top: 0px; right: 0px; bottom: 0px; overflow: auto; padding: 18px; }
.img-view { display: block; text-align: center; padding: 20px; }
.info-line { display: block; color: #8b93a3; margin-top: 10px; font-size: 13px; }

/* --- Инспектор ----------------------------------------------------------------- */
#inspector {
    display: flex; flex-direction: column; width: 300px; flex: 0 0 300px;
    background-color: #1b1e24; border-left: 1px #2a2f39;
}
.insp-head { display: block; padding: 4px 16px 12px 16px; border-bottom: 1px #2a2f39; }
.insp-name { display: block; font-size: 15px; font-weight: bold; color: #e6e9ef; word-break: break-all; }
.insp-path { display: block; margin-top: 2px; font-size: 11px; color: #7d8596; word-break: break-all; }
.insp-sec { display: block; padding: 10px 16px 6px 16px; }
.insp-title { display: block; font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: #7d8596; margin-bottom: 6px; }
.kv { display: flex; flex-direction: row; align-items: flex-start; padding: 6px 0px; border-bottom: 1px #242932; }
.kv-k { flex: 0 0 88px; font-size: 12px; color: #8b93a3; }
.kv-v { flex: 1 1 0; font-size: 13px; color: #e6e9ef; word-break: break-all; }
.kv-act { flex: 0 0 auto; margin-left: 8px; font-size: 12px; color: #4fa3ff; cursor: pointer; }
.kv-act:hover { color: #8cc4ff; text-decoration: underline; }
.dot { display: inline-block; width: 7px; height: 7px; margin-right: 7px; border-radius: 4px; background-color: #6b7280; }
.dot.ok { background-color: #3fb950; }
.dot.warn { background-color: #e3b341; }
.dot.err { background-color: #f14c4c; }
.insp-note { display: block; font-size: 12px; color: #6b7280; margin-bottom: 8px; }

/* --- Нижняя панель ----------------------------------------------------------- */
#bottom {
    display: flex; flex-direction: column; height: 190px; flex: 0 0 190px;
    background-color: #1b1e24; border-top: 1px #2a2f39;
}
#bottom.collapsed { height: 34px; flex: 0 0 34px; }
#bottom-tabs { display: flex; flex-direction: row; align-items: center; height: 34px; flex: 0 0 34px; padding: 0px 8px; }
.btab { display: inline-block; padding: 7px 12px; font-size: 13px; color: #9aa2b1; cursor: pointer; }
.btab:hover { color: #e6e9ef; }
.btab.on { color: #ffffff; border-bottom: 2px #3b82f6; }
.badge {
    display: inline-block; min-width: 10px; padding: 0px 5px; margin-left: 6px; font-size: 11px; line-height: 16px;
    text-align: center; color: #ffffff; background-color: #c93c3c; border-radius: 8px;
}
.badge.zero { background-color: #3a404c; }
#bottom-body { display: block; flex: 1 1 0; overflow-y: auto; }
#bottom.collapsed #bottom-body { display: none; }
.prob-head, .prob {
    display: flex; flex-direction: row; height: 26px; line-height: 26px; padding: 0px 12px; font-size: 13px;
}
.prob-head { color: #8b93a3; border-bottom: 1px #2a2f39; }
.prob { cursor: pointer; }
.prob:hover { background-color: #23272f; }
.prob .c-type, .prob-head .c-type { width: 34px; flex: 0 0 34px; }
.prob .c-msg, .prob-head .c-msg { flex: 1 1 0; white-space: nowrap; overflow: hidden; }
.c-code { width: 230px; flex: 0 0 230px; margin-right: 10px; color: #8b93a3; white-space: nowrap; overflow: hidden; }
.c-file { width: 220px; flex: 0 0 220px; color: #4fa3ff; white-space: nowrap; overflow: hidden; }
.c-num { width: 56px; flex: 0 0 56px; text-align: right; color: #8b93a3; }
.sev-error { color: #f14c4c; }
.sev-warning { color: #e2b33c; }
.sev-info { color: #4fa3ff; }
.log { display: block; padding: 6px 12px; font-family: Roboto Mono; font-size: 12px; white-space: pre; color: #c3c9d4; }
.out-toolbar { display: flex; flex-direction: row; gap: 6px; padding: 6px 10px; border-bottom: 1px #2a2f39; }
.out-filter { padding: 3px 9px; border-radius: 4px; color: #9aa2b1; background-color: #1b1e24; font-size: 12px; }
.out-filter:hover { color: #e6e9ef; }
.out-filter.on { color: #ffffff; background-color: #1f3a5f; }
.out-log { display: block; padding: 4px 0px; }
.out-row { display: flex; flex-direction: row; align-items: flex-start; min-height: 22px; padding: 3px 10px; font-family: Roboto Mono; font-size: 12px; color: #c3c9d4; }
.out-time { flex: 0 0 74px; color: #788396; }
.out-source { flex: 0 0 58px; color: #8bb8f4; }
.out-text { flex: 1 1 0; white-space: pre-wrap; }
.empty { display: block; padding: 10px 14px; color: #6b7280; font-size: 13px; }

#statusbar {
    display: flex; flex-direction: row; align-items: center; height: 26px; flex: 0 0 26px; padding: 0px 12px;
    font-size: 12px; color: #9aa2b1; background-color: #1b1e24; border-top: 1px #2a2f39;
}
.st { display: inline-block; margin-right: 16px; }
.st.right { margin-right: 0px; margin-left: 16px; }
.st.ok { color: #4ad991; }
.st.err { color: #f14c4c; }

/* --- Палитра команд / Quick Open ---------------------------------------------- */
#palette {
    display: block; position: absolute; top: 48px; left: 50%; width: 620px; margin-left: -310px;
    background-color: #23272f; border-width: 1px; border-color: #3a404c; border-radius: 8px;
}
#palette-input {
    display: block; width: 588px; margin: 8px; padding: 6px 8px; color: #e6e9ef;
    background-color: #14161b; border-width: 1px; border-color: #3b82f6; border-radius: 4px;
}
#palette-hint { display: block; padding: 6px 12px; font-size: 11px; color: #8b93a3; border-top-width: 1px; border-color: #343a46; }
#palette-list { display: block; max-height: 360px; overflow-y: auto; padding-bottom: 6px; }
.pal-row { display: flex; flex-direction: row; height: 28px; line-height: 28px; padding: 0px 12px; cursor: pointer; font-size: 13px; }
.pal-row:hover { background-color: #2c313b; }
.pal-row.sel { background-color: #1f3a5f; }
.pal-label { flex: 1 1 0; color: #e6e9ef; white-space: nowrap; overflow: hidden; }
.pal-detail { color: #8b93a3; margin-left: 12px; white-space: nowrap; }
.pal-hit { color: #4fa3ff; }

/* Явное подтверждение закрытия документа с отдельными Save / Discard / Cancel. */
#close-confirm { display: flex; position: absolute; z-index: 100; left: 0px; top: 0px; width: 100%; height: 100%; align-items: center; justify-content: center; }
#file-conflict { display: flex; position: absolute; z-index: 110; left: 0px; top: 0px; width: 100%; height: 100%; align-items: center; justify-content: center; }
.close-scrim { display: block; position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; background-color: rgba(4, 6, 10, 180); }
.close-dialog { display: block; position: relative; width: 560px; padding: 20px; background-color: #20242b; border-width: 1px; border-color: #4a5260; border-radius: 8px; }
.close-title { display: block; color: #f0f2f6; font-size: 17px; }
.close-message { display: block; margin-top: 10px; color: #b8bec9; white-space: normal; }
.close-path { color: #9dc9ff; font-family: Roboto Mono; }
.close-actions { display: flex; flex-direction: row; align-items: center; margin-top: 22px; }
.close-actions .btn { margin-left: 8px; white-space: nowrap; }
.close-actions .btn:first-child { margin-left: 0px; }
.btn.danger { color: #ffb4ab; border-color: #7f3434; background-color: #3a2225; }
.btn.danger:hover { background-color: #512b2e; }

/* --- Project Manager ----------------------------------------------------------- */
#pm { display: flex; flex-direction: column; width: 100%; height: 100%; background-color: #14161b; }
#pm-top { display: flex; flex-direction: row; align-items: center; padding: 28px 48px 20px 48px; border-bottom: 1px #23272f; }
#pm-logo {
    display: block; width: 44px; height: 44px; line-height: 44px; text-align: center; margin-right: 14px;
    border-radius: 10px; background-color: #2563eb; color: #ffffff; font-size: 26px;
}
.pm-brand { display: block; }
.pm-name { display: block; font-size: 22px; color: #e6e9ef; }
.pm-tag { display: block; font-size: 13px; color: #8b93a3; margin-top: 2px; }
#pm-body { display: flex; flex-direction: row; flex: 1 1 0; overflow: hidden; }
#pm-col-open { display: block; flex: 1 1 0; padding: 24px 40px 32px 48px; overflow-y: auto; }
#pm-col-new {
    display: block; width: 430px; flex: 0 0 430px; padding: 24px 32px 32px 32px; overflow-y: auto;
    background-color: #191c22; border-left: 1px #23272f;
}
.pm-sec-head { display: flex; flex-direction: row; align-items: center; margin: 4px 0px 10px 0px; }
.pm-sec-title { display: block; font-size: 15px; color: #e6e9ef; margin-bottom: 10px; }
.pm-sec-head .pm-sec-title { margin-bottom: 0px; }
.pm-count { display: block; margin-left: 8px; padding: 1px 7px; font-size: 11px; color: #9aa3b2; background-color: #23272f; border-radius: 8px; }
#pm-recent { display: block; margin-bottom: 26px; }
.pm-row {
    display: flex; flex-direction: row; align-items: center; padding: 10px 12px; margin-bottom: 6px; cursor: pointer;
    border-radius: 8px; background-color: #1b1e24; border-width: 1px; border-color: #262a33;
}
.pm-row:hover { border-color: #3b82f6; background-color: #1e222a; }
.pm-row.missing { cursor: default; }
.pm-row.missing:hover { border-color: #262a33; background-color: #1b1e24; }
.pm-row.missing .pm-title, .pm-row.missing .pm-ico { color: #5d6472; }
.pm-ico {
    display: block; width: 34px; height: 34px; line-height: 34px; text-align: center; flex: 0 0 34px;
    margin-right: 12px; border-radius: 7px; background-color: #23272f; color: #7aa7ff; font-size: 20px;
}
.pm-info { display: block; flex: 1 1 0; overflow: hidden; }
.pm-title { display: block; color: #e6e9ef; }
.pm-path { display: block; font-size: 12px; color: #7b8494; margin-top: 2px; white-space: nowrap; overflow: hidden; }
.pm-badge { display: block; margin-left: 8px; padding: 1px 7px; font-size: 11px; border-radius: 8px; color: #9aa3b2; background-color: #23272f; }
.pm-badge.warn { color: #e2b65b; background-color: #2e2818; }
.pm-x {
    display: block; width: 26px; height: 26px; line-height: 26px; text-align: center; flex: 0 0 26px; margin-left: 8px;
    border-radius: 5px; color: #6b7280; font-size: 16px; cursor: pointer;
}
.pm-x:hover { color: #e6e9ef; background-color: #30353f; }
.pm-open { display: inline-block; margin-left: 0px; padding: 8px 16px; }
.pm-dirbar { display: flex; flex-direction: row; align-items: center; }
.pm-dir {
    display: block; flex: 1 1 0; padding: 6px 10px; color: #c9cfda; background-color: #14161b; font-size: 13px;
    border-width: 1px; border-color: #2f3440; border-radius: 5px; white-space: nowrap; overflow: hidden;
}
.pm-hint { display: block; font-size: 12px; color: #6b7280; margin-top: 6px; }
.pm-step { display: block; font-size: 12px; letter-spacing: 1px; color: #8b93a3; margin: 16px 0px 8px 0px; }
#pm-templates { display: block; }
.pm-tpl {
    display: flex; flex-direction: row; align-items: center; padding: 8px 10px; margin-bottom: 6px; cursor: pointer;
    border-radius: 8px; background-color: #1f232b; border-width: 1px; border-color: #2a2f39;
}
.pm-tpl:hover { border-color: #3b82f6; }
.pm-tpl.selected { border-color: #3b82f6; background-color: #1d2a44; }
.pm-tpl.selected .pm-ico { background-color: #2563eb; color: #ffffff; }
.pm-tpl-name { display: block; color: #e6e9ef; font-size: 14px; }
.pm-tpl-desc { display: block; color: #7b8494; font-size: 11px; margin-top: 2px; }
.pm-dest { display: block; font-size: 12px; color: #8b93a3; margin-top: 8px; word-break: break-all; }
.pm-dest.bad { color: #e2b65b; }
.pm-create { display: block; width: 100%; box-sizing: border-box; margin: 18px 0px 0px 0px; margin-left: 0px; padding: 9px 14px; text-align: center; }
#pm-col-new .field { display: block; width: 100%; box-sizing: border-box; }
#pm .pm-openbar .field { flex: 1 1 0; }
.field {
    display: block; flex: 1 1 0; padding: 6px 10px; color: #e6e9ef; background-color: #14161b;
    border-width: 1px; border-color: #2f3440; border-radius: 5px; cursor: text;
}
.field:focus { border-color: #3b82f6; }
.form { display: flex; flex-direction: row; align-items: center; margin: 6px 0px; }
.btn {
    display: inline-block; padding: 6px 14px; margin-left: 8px; color: #e6e9ef; cursor: pointer;
    background-color: #262a33; border-width: 1px; border-color: #343a46; border-radius: 5px;
}
.btn:hover { background-color: #30353f; }
.btn.primary { background-color: #2563eb; border-color: #3b82f6; }
.btn.primary:hover { background-color: #3b82f6; }
.pm-err { display: block; color: #f14c4c; margin-top: 8px; font-size: 13px; }
#pm .pm-open, #pm .pm-create { margin-left: 0px; }

/* --- Граф проекта --------------------------------------------------------------- */
#gp { display: flex; flex-direction: column; flex: 1 1 0; min-height: 0px; background-color: #14161b; position: relative; }
#bottom.graph { height: 330px; flex: 0 0 330px; }
#bottom.graph.tall { height: 560px; flex: 0 0 560px; }
#bottom.collapsed #gp { display: none; }
#bottom.graph #bottom-body { display: none; }
#gp-head { display: flex; flex-direction: row; align-items: center; flex: 0 0 32px; height: 32px; padding: 0px 8px; background-color: #1b1e24; border-top: 1px #2a2f39; border-bottom: 1px #2a2f39; overflow: hidden; }
#gp-head .tb-btn { padding: 4px 5px; margin-right: 0px; }
.gp-h-title { display: none; }
#gp-crumbs { display: flex; flex-direction: row; align-items: center; flex: 1 1 0; min-width: 0px; overflow: hidden; white-space: nowrap; }
.gp-crumb { display: inline-block; padding: 2px 5px; font-size: 12px; color: #9dc9ff; cursor: pointer; border-radius: 4px; }
.gp-crumb:hover { background-color: #2a2f39; }
.gp-crumb.last { color: #e6e9ef; cursor: default; }
.gp-sep { display: inline-block; width: 16px; text-align: center; font-size: 14px; color: #5b6270; }
.gp-warn { display: inline-block; margin-left: 10px; font-size: 12px; color: #e2b33c; white-space: nowrap; }
#gp-search { display: inline-block; flex: 0 0 110px; width: 110px; height: 14px; margin-right: 8px; padding: 4px 8px; font-size: 12px; color: #e6e9ef; background-color: #121418; border-width: 1px; border-color: #2f3440; border-radius: 5px; }
.gp-vbtn { display: inline-block; flex: 0 0 auto; padding: 3px 6px; margin-right: 0px; font-size: 12px; color: #9aa2b1; border-radius: 4px; cursor: pointer; white-space: nowrap; }
.gp-vbtn:hover { color: #e6e9ef; }
.gp-vbtn.on { color: #ffffff; background-color: #1f3a5f; }
.gp-stat { display: inline-block; flex: 0 0 auto; margin: 0px 6px; padding: 2px 9px; font-size: 11px; color: #4ad991; background-color: #14161b; border-width: 1px; border-color: #2f3440; border-radius: 10px; white-space: nowrap; }
.gp-stat.warn { color: #e2b33c; border-color: #6b5a22; }
.gp-stat.bad { color: #8b93a3; }
#gp-results { display: block; position: absolute; z-index: 40; right: 150px; top: 42px; width: 340px; max-height: 280px; overflow-y: auto; background-color: #23272f; border-width: 1px; border-color: #3a404c; border-radius: 6px; }
.gp-res { display: flex; flex-direction: row; height: 26px; line-height: 26px; padding: 0px 10px; cursor: pointer; font-size: 12px; }
.gp-res:hover { background-color: #2c313b; }
.gp-res-t { flex: 1 1 0; color: #e6e9ef; white-space: nowrap; overflow: hidden; }
.gp-res-d { color: #8b93a3; margin-left: 10px; white-space: nowrap; }
#gp-body { display: block; flex: 1 1 0; min-height: 0px; position: relative; overflow: hidden; background-color: #101216; }
#gp-canvas { display: block; position: absolute; left: 0px; top: 0px; right: 0px; bottom: 0px; }
#gp-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; position: absolute; left: 0px; top: 0px; right: 0px; bottom: 0px; }
.gp-empty-t { display: block; margin-bottom: 12px; color: #8b93a3; font-size: 13px; }
#gp-mini { display: block; position: absolute; right: 10px; bottom: 10px; width: 150px; height: 86px; background-color: rgba(27, 30, 36, 220); border-width: 1px; border-color: #343a46; border-radius: 4px; overflow: hidden; }
.gp-mn { display: block; position: absolute; background-color: #4a5160; }
.gp-mn.k-scene { background-color: #3b82f6; }
.gp-mn.k-world { background-color: #2ea043; }
.gp-mn.k-object { background-color: #8a6cff; }
.gp-mn.k-resource { background-color: #d38b2e; }
.gp-mv { display: block; position: absolute; border-width: 1px; border-color: #e6e9ef; }
.gp-col { display: block; position: absolute; color: #6b7280; white-space: nowrap; }
.gp-seg { display: block; position: absolute; background-color: #5b6a85; }
.gp-seg.gp-e-spatial_parent { background-color: #6a7aa0; }
.gp-seg.gp-e-uses_resource { background-color: #c98b3a; }
.gp-seg.gp-e-scene_registration, .gp-seg.gp-e-scene_world { background-color: #3b82f6; }
.gp-seg.derived { background-color: #44506a; }
.gp-arrow { display: block; position: absolute; color: #6a7aa0; }
.gp-arrow.gp-e-uses_resource { color: #c98b3a; }
.gp-arrow.gp-e-scene_registration, .gp-arrow.gp-e-scene_world { color: #3b82f6; }
.gp-lbl { display: block; position: absolute; color: #8b93a3; white-space: nowrap; }
.gp-card {
    display: flex; flex-direction: row; align-items: center; position: absolute; box-sizing: border-box; padding: 0px 8px;
    overflow: hidden; cursor: pointer; background-color: #1d222b; border-width: 1px; border-color: #3a4252; border-radius: 7px;
}
.gp-card:hover { border-color: #6a7aa0; }
.gp-card.sel { border-color: #ffffff; background-color: #263040; }
.gp-card.k-scene { border-color: #2b6cb0; background-color: #16263d; }
.gp-card.k-world { border-color: #2ea043; background-color: #14301c; }
.gp-card.k-object { border-color: #6f58d6; background-color: #1e1a3a; }
.gp-card.k-resource { border-color: #a8731f; background-color: #33250f; }
.gp-card.k-script { border-color: #4a5160; background-color: #20242b; }
.gp-card.missing { border-color: #c93c3c; }
.gp-card.dynamic { border-color: #9a7bff; }
.gp-card.root { border-width: 2px; }
.gp-ico { display: inline-block; flex: 0 0 auto; width: 1.6em; font-size: 1.5em; color: #c9ced8; }
.gp-txt { display: block; flex: 1 1 0; overflow: hidden; white-space: nowrap; }
.gp-t { display: block; font-size: 1em; color: #f0f2f6; white-space: nowrap; overflow: hidden; }
.gp-s { display: block; font-size: 0.82em; color: #8b93a3; white-space: nowrap; overflow: hidden; }
.gp-badge { display: inline-block; flex: 0 0 auto; margin-left: 4px; padding: 0px 6px; font-size: 0.85em; color: #ffffff; background-color: #3b4560; border-radius: 8px; }
.gp-open { display: inline-block; flex: 0 0 auto; font-size: 1.3em; color: #8b93a3; }

/* project.json как текст: переключатель «Настройки | JSON» */
#code-switch { display: flex; flex-direction: row; position: absolute; z-index: 5; top: 30px; right: 110px; padding: 2px; background-color: #1b1e24; border-width: 1px; border-color: #343a46; border-radius: 6px; font-family: Open Sans; }
.cs-btn { display: inline-block; padding: 3px 10px; font-size: 12px; color: #9aa2b1; border-radius: 4px; cursor: pointer; }
.cs-btn:hover { color: #ffffff; }
.cs-btn.on { color: #ffffff; background-color: #1f3a5f; cursor: default; }

/* --- Кирпичики (docs/SNIPPETS.md) ------------------------------------------------ */
#side-body input.st-in, #side-body select.st-in {
    display: block; width: 100%; box-sizing: border-box; height: 28px; padding: 5px 8px; margin: 2px 0px; font-size: 13px;
    color: #e6e9ef; background-color: #14161b; border-width: 1px; border-color: #2f3440; border-radius: 4px; cursor: text;
}
#side-body input.st-in:focus { border-color: #3b82f6; }
#side-body input.st-in.sn-half { display: inline-block; width: 48%; margin-right: 2%; }
#side-body .st-btn {
    display: inline-block; padding: 4px 9px; margin: 2px 4px 2px 0px; color: #d7dce6; font-size: 12px; cursor: pointer;
    white-space: nowrap; background-color: #262a33; border-width: 1px; border-color: #343a46; border-radius: 4px;
}
#side-body .st-btn:hover { background-color: #30353f; border-color: #4a5160; }
#side-body .st-btn.primary { background-color: #238636; border-color: #2ea043; color: #ffffff; }
.sn-owner, .sn-form, .sn-row { display: block; padding: 0px 10px; }
.sn-h { display: block; margin: 12px 10px 4px 10px; color: #8b93a3; font-size: 11px; }
.sn-cat { display: block; margin: 8px 10px 2px 10px; color: #6b7384; font-size: 11px; }
.sn-inst, .sn-pkg, .sn-set { display: block; padding: 4px 10px; font-size: 13px; color: #d7dce6; cursor: pointer; }
.sn-inst:hover, .sn-pkg:hover { background-color: #23272f; }
.sn-inst.open { background-color: #1f3a5f; color: #ffffff; }
.sn-inst.off { color: #5b6270; }
.sn-desc { display: block; color: #7b8494; font-size: 11px; margin-left: 22px; }
.sn-field { display: block; margin: 6px 0px; }
.sn-field label { display: block; color: #8b93a3; font-size: 12px; }
.sn-hint, .sn-note { display: block; color: #6b7384; font-size: 11px; padding: 2px 10px 2px 0px; }
.sn-note { padding: 4px 10px; }
.sn-err { display: block; color: #f14c4c; font-size: 11px; padding: 2px 10px 2px 0px; }
.sn-row .sn-err, .sn-row .sn-hint { padding-left: 0px; }
.sn-st { display: inline-block; width: 64px; font-size: 11px; color: #8b93a3; }
.sn-st.create, .sn-st.update { color: #4ad991; }
.sn-st.conflict { color: #f14c4c; }
.sn-st.delete { color: #e2b33c; }

/* Превью исходника сниппетов до применения native generate. */
.sn-diff { display: block; max-height: 220px; overflow: auto; white-space: pre; font-family: Roboto Mono; font-size: 11px; color: #c3c9d4; background-color: #10141c; padding: 6px; margin: 4px 8px; }

/* --- Агент: вкладка нижней панели --- */
#ag { display: flex; flex-direction: column; flex: 1 1 0; min-height: 0px; background-color: #14161b; }
#ag.hidden, #agcfg.hidden, #mc-bubble.hidden, #ag-ask.hidden, #ag-stop.hidden, #ag-send.hidden { display: none; }
#bottom.collapsed #ag { display: none; }
#bottom.agent { height: 420px; flex: 0 0 420px; }
#bottom.agent #bottom-body { display: none; }
#bottom.collapsed #agcfg { display: none; }
#ag-top { display: flex; flex-direction: row; align-items: center; height: 36px; flex: 0 0 36px; padding: 0px 8px 0px 16px; border-bottom: 1px #232730; }
#ag-top .tb-btn { margin-right: 0px; padding: 3px 7px; font-size: 18px; color: #9aa2b1; }
#ag-top .tb-btn:hover { color: #ffffff; }
#ag-top .ag-modelchip { margin-left: 8px; }
.ag-pill { padding: 2px 10px; border-radius: 10px; font-size: 11px; color: #9aa2b1; background-color: #262a33; }
.ag-pill.busy { color: #9cc2ff; background-color: #1f3a5f; }
.ag-pill.wait { color: #f2c14e; background-color: #3a2f12; }
.ag-pill.need { color: #f2c14e; background-color: #3a2f12; }

/* вкладка «Настройки агента» */
#agcfg { display: block; flex: 1 1 0; min-height: 0px; background-color: #14161b; }
#agcfg-scroll { display: block; height: 100%; overflow-y: auto; padding: 4px 24px 18px 24px; }
.cfg-h { display: block; margin: 14px 0px 9px 0px; font-size: 12px; color: #8b93a3; }
#cfg-provs { display: flex; flex-direction: row; flex-wrap: wrap; }
.cfg-card { display: block; width: 214px; margin: 0px 8px 8px 0px; padding: 9px 11px; background-color: #1b1e24; border-width: 1px; border-color: #2a2f39; border-radius: 9px; cursor: pointer; }
.cfg-card:hover { border-color: #4a5160; background-color: #20242c; }
.cfg-card.on { border-color: #2f5a94; background-color: #1c2d47; }
.cfg-name { display: block; font-size: 13px; color: #e6e9ef; margin-bottom: 3px; }
.cfg-desc { display: block; font-size: 10px; color: #7d8594; }
.cfg-row { display: flex; flex-direction: row; align-items: flex-end; margin-top: 4px; }
.cfg-row.center { align-items: center; margin-top: 10px; }
.cfg-col { display: block; flex: 1 1 0; margin-right: 12px; }
.cfg-col.wide { flex: 1.5 1 0; }
.cfg-label { display: block; margin: 8px 0px 4px 0px; font-size: 11px; color: #8b93a3; }
#cfg-result { display: block; margin-left: 14px; font-size: 12px; color: #8b93a3; }
#cfg-result.ok { color: #3fb950; }
#cfg-result.err { color: #f87171; }
.cfg-note { display: block; margin-top: 14px; font-size: 11px; color: #5d6575; }
.ag-chip { display: block; padding: 5px 12px; margin: 0px 6px 0px 0px; border-radius: 12px; font-size: 12px; color: #9aa2b1; background-color: #20242c; border-width: 1px; border-color: #2d323d; cursor: pointer; }
.ag-chip:hover { color: #e6e9ef; border-color: #4a5160; }
.ag-chip.on { color: #ffffff; background-color: #1f3a5f; border-color: #2f5a94; }
.ag-field { display: block; width: 100%; box-sizing: border-box; padding: 7px 10px; color: #e6e9ef; background-color: #101216; border-width: 1px; border-color: #2f3440; border-radius: 6px; font-size: 13px; cursor: text; }
.ag-field:focus { border-color: #3b82f6; }

/* маскот */
#ag-body { display: flex; flex-direction: row; flex: 1 1 0; min-height: 0px; }
#ag-col { display: flex; flex-direction: column; flex: 1 1 0; min-width: 0px; min-height: 0px; }
#ag-side { display: block; width: 230px; flex: 0 0 230px; padding: 6px 12px 0px 0px; text-align: center; }
#mc { display: block; width: 200px; height: 200px; margin: 0px auto; cursor: pointer; }
#mc.off { display: none; }
#ag-side.off { display: none; }
#mc-bubble { display: block; margin: 8px 6px 4px 6px; padding: 6px 10px; font-size: 12px; color: #1b1e24; background-color: #eef1f7; border-radius: 10px; }
#bt-agent-mc { display: inline-block; width: 20px; height: 20px; margin-right: 5px; vertical-align: middle; }

/* журнал */
#ag-log { display: block; flex: 1 1 0; overflow-y: auto; padding: 14px 12px 6px 24px; }
.agm { display: block; margin-bottom: 12px; }
.ag-ub { display: block; margin-left: 30%; padding: 9px 12px; font-size: 13px; color: #e8f0ff; background-color: #1f3a5f; border-radius: 10px; white-space: pre-wrap; }
.agm-bot { display: flex; flex-direction: row; }
.ag-av { display: block; width: 28px; height: 28px; flex: 0 0 28px; margin-right: 8px; decorator: image(emo_0); }
.ag-bt { display: block; flex: 1 1 0; padding-top: 2px; font-size: 13px; line-height: 1.5; color: #d6dbe5; white-space: pre-wrap; }
.ag-tools { display: block; margin: 0px 0px 10px 32px; }
.agt { display: flex; flex-direction: row; align-items: center; padding: 6px 9px; margin-bottom: 3px; border-radius: 7px; background-color: #1a1d23; cursor: pointer; }
.agt:hover { background-color: #21252d; }
.agt-ic { display: block; width: 18px; margin-right: 7px; font-size: 15px; color: #7aa2f7; }
.agt-name { display: block; margin-right: 8px; font-size: 12px; color: #c3c9d4; }
.agt-arg { display: block; flex: 1 1 0; font-family: Roboto Mono; font-size: 11px; color: #667084; }
.agt-st { display: block; width: 16px; margin-left: 6px; font-size: 14px; text-align: right; color: #667084; }
.agt-st.ok { color: #3fb950; }
.agt-st.err { color: #f87171; }
.agt-st.run { color: #9cc2ff; }
.agt-res { display: block; margin: 0px 0px 6px 0px; padding: 8px 10px; font-family: Roboto Mono; font-size: 11px; line-height: 1.45; color: #8b93a3; background-color: #101216; border-radius: 7px; white-space: pre-wrap; }
.ag-errbox { display: block; margin: 0px 0px 12px 0px; padding: 9px 12px; font-size: 12px; color: #fca5a5; background-color: #2c1618; border-radius: 8px; white-space: pre-wrap; }
.ag-working { display: block; margin: 2px 0px 10px 32px; font-size: 12px; color: #6f7a8f; }

/* пустое состояние */
.ag-empty { display: block; padding: 28px 6px 8px 6px; text-align: center; }
.ag-empty-ic { display: block; font-size: 36px; color: #3b82f6; margin-bottom: 8px; }
.ag-empty-h { display: block; font-size: 17px; color: #e6e9ef; margin-bottom: 6px; }
.ag-empty-p { display: block; margin: 0px 18px 18px 18px; font-size: 12px; line-height: 1.5; color: #7d8594; }
.ag-sug { display: block; margin: 0px 0px 6px 0px; padding: 9px 12px; text-align: left; font-size: 12px; color: #c3c9d4; background-color: #1b1e24; border-width: 1px; border-color: #2a2f39; border-radius: 8px; cursor: pointer; }
.ag-sug:hover { color: #ffffff; background-color: #20242c; border-color: #3b4252; }

/* подтверждение */
#ag-ask { display: block; flex: 0 0 auto; margin: 0px 12px 10px 24px; padding: 11px 12px; background-color: #221d10; border-width: 1px; border-color: #5a4713; border-radius: 9px; }
.ask-head { display: block; font-size: 12px; color: #f2c14e; margin-bottom: 7px; }
.ask-body { display: block; font-size: 12px; color: #e6e9ef; margin-bottom: 9px; }
.ask-code { display: block; margin-top: 6px; padding: 7px 9px; font-family: Roboto Mono; font-size: 11px; color: #aeb6c5; background-color: #14161b; border-radius: 6px; white-space: pre-wrap; }
.ask-del { display: block; margin-top: 6px; padding: 6px 9px; font-family: Roboto Mono; font-size: 11px; color: #fca5a5; background-color: #2c1618; border-radius: 6px; white-space: pre-wrap; }
.ask-add { display: block; margin-top: 4px; padding: 6px 9px; font-family: Roboto Mono; font-size: 11px; color: #86efac; background-color: #12261a; border-radius: 6px; white-space: pre-wrap; }
.ask-btns { display: flex; flex-direction: row; }
.ask-yes { display: block; padding: 6px 16px; margin-right: 8px; font-size: 12px; color: #ffffff; background-color: #238636; border-radius: 6px; cursor: pointer; }
.ask-yes:hover { background-color: #2ea043; }
.ask-no { display: block; padding: 6px 16px; font-size: 12px; color: #c3c9d4; background-color: #2a2f39; border-radius: 6px; cursor: pointer; }
.ask-no:hover { background-color: #343a46; }

/* ввод */
#ag-compose { display: flex; flex-direction: row; align-items: flex-end; flex: 0 0 auto; padding: 10px 16px 12px 16px; background-color: #1b1e24; border-top: 1px #2a2f39; }
.ag-input { display: block; flex: 1 1 0; box-sizing: border-box; height: 52px; padding: 8px 12px; font-size: 13px; color: #e6e9ef; background-color: #101216; border-width: 1px; border-color: #2f3440; border-radius: 8px; cursor: text; }
.ag-input:focus { border-color: #3b82f6; }
#ag-compose-side { display: block; width: 120px; flex: 0 0 120px; margin-left: 12px; text-align: center; }
#ag-hint { display: block; margin-top: 5px; font-size: 10px; color: #5d6575; }
.ag-modelchip { display: block; padding: 3px 9px; font-size: 11px; color: #8b93a3; background-color: #20242c; border-radius: 10px; cursor: pointer; }
.ag-modelchip:hover { color: #e6e9ef; }
.ag-send { display: block; padding: 7px 16px; font-size: 12px; color: #ffffff; background-color: #2563eb; border-radius: 6px; cursor: pointer; }
.ag-send:hover { background-color: #3b82f6; }
.ag-send.disabled { color: #8b93a3; background-color: #2a2f39; }
.ag-stop { display: block; padding: 7px 16px; font-size: 12px; color: #ffffff; background-color: #b42318; border-radius: 6px; cursor: pointer; }
.ag-stop:hover { background-color: #d92d20; }
