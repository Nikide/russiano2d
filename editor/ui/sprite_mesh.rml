<rml>
<head>
<!-- SpriteMesh во вкладке Editor. Логика — sdk/tools/sprite-mesh-studio.js;
     раскладка по макету Editor, id — те же, что в sdk/ui/sprite_mesh_studio.rml.
     Центр прозрачный: меш рисует $.spriteMesh.draw в проходе сцены. -->
<link type="text/rcss" href="../../sdk/ui/theme.rcss"/><link type="text/rcss" href="../../sdk/ui/studio.rcss"/><link type="text/rcss" href="hammer.rcss"/><link type="text/rcss" href="sprite_mesh.rcss"/>
<title>SpriteMesh</title>
</head>
<body>
<div class="hm-root">
  <div class="hm-main">
    <div class="sm-center">
      <div class="hm-bar sm-viewbar">
        <select id="sm-preview-mode" class="field sm-mode"><option value="textured">Shaded</option><option value="wireframe">Wireframe</option></select>
        <span class="we-spacer"></span>
        <button id="sm-front" class="hm-btn" title="Камера спереди">Спереди</button>
        <button id="sm-angle" class="hm-btn" title="Камера под углом">Под углом</button>
        <button id="sm-back-view" class="hm-btn" title="Камера сзади">Сзади</button>
        <button id="sm-reset-camera" class="hm-btn" title="Сбросить камеру">Сброс</button>
      </div>
      <div id="sm-view" class="sm-view"></div>
      <div id="sm-hud" class="sm-hud">—</div>

      <!-- Анимация: теги, лента кадров, транспорт -->
      <div class="sm-anim">
        <div class="sm-anim-row">
          <span class="sm-anim-title">Animation</span>
          <div id="sm-animations" class="sm-tags"></div>
          <span class="we-spacer"></span>
          <select id="sm-animation" class="field sm-anim-select"></select>
        </div>
        <div id="sm-frames" class="sm-strip"></div>
        <div class="sm-anim-row">
          <button id="sm-prev" class="hm-btn" title="Предыдущий кадр">|&lt;</button>
          <button id="sm-play" class="hm-btn hm-primary" title="Пуск">Play</button>
          <button id="sm-pause" class="hm-btn" title="Пауза">Pause</button>
          <button id="sm-restart" class="hm-btn" title="Сначала">Restart</button>
          <button id="sm-next" class="hm-btn" title="Следующий кадр">&gt;|</button>
          <span class="hm-label">длительности кадров — из атласа</span>
        </div>
      </div>
    </div>

    <div class="hm-right sm-right">
      <div class="hm-insp">
        <button id="sm-back" class="hm-hidden">Назад</button>
        <div class="hm-title">SpriteMesh</div>
        <div class="hm-h hm-h-first">Source</div>
        <div class="hm-field"><label>Файл</label><span id="sm-file" class="sm-file">—</span></div>
        <div class="hm-h">Mesh Settings</div>
        <div class="hm-field"><label>Depth (Z)</label><input id="sm-depth" class="field" type="text" value="0.08"/></div>
        <div class="hm-field"><label>Alpha thr.</label><input id="sm-threshold" class="field" type="text" value="16"/></div>
        <div class="hm-field"><label>Units/px</label><input id="sm-upp" class="field" type="text" value="0.03125"/></div>
        <div class="hm-field"><label>Pivot X</label><input id="sm-px" class="field" type="text" value="0"/></div>
        <div class="hm-field"><label>Pivot Y</label><input id="sm-py" class="field" type="text" value="0"/></div>
        <button id="sm-apply" class="hm-btn hm-wide" title="Пересобрать предпросмотр с этими настройками (файл не меняется)">Применить к предпросмотру</button>
        <div class="hm-h">Текущий кадр</div>
        <div id="sm-stats" class="sm-stats">Mesh cache ещё не собран.</div>
        <div id="sm-errors" class="sm-errors"></div>
      </div>
      <div class="sm-footer">
        <button id="sm-save-bake" class="hm-btn hm-primary hm-wide" title="Записать настройки в атлас (re2d.spriteMesh) и запечь cache всех кадров">Save + Bake Mesh</button>
        <div class="sm-cache"><span id="sm-state" class="sm-state">—</span></div>
        <span class="sm-note">ЛКМ — вращение · колесо — масштаб</span>
      </div>
    </div>
  </div>
</div>
</body>
</rml>
