<rml>
<head>
    <link type="text/rcss" href="editor.rcss"/>
    <title>Russiano2D Editor</title>
</head>
<body>
<!-- Project Manager: без открытого проекта -->
<div id="pm">
    <div id="pm-top">
        <div id="pm-logo"></div>
        <div class="pm-brand">
            <span class="pm-name">Russiano2D Editor</span>
            <span class="pm-tag">Откройте проект или начните новый</span>
        </div>
    </div>
    <div id="pm-body">
        <div id="pm-col-open">
            <div class="pm-sec-head"><span class="pm-sec-title">Недавние проекты</span><span id="pm-recent-count" class="pm-count"></span></div>
            <div id="pm-recent"></div>
            <button id="pm-open" class="btn primary pm-open">Открыть проект…</button>
            <span class="pm-hint">Выберите папку, в которой лежит project.json.</span>
            <div id="pm-error" class="pm-err"></div>
        </div>
        <div id="pm-col-new">
            <span class="pm-sec-title">Новый проект</span>
            <span class="pm-step">1 · Шаблон</span>
            <div id="pm-templates"></div>
            <span class="pm-step">2 · Название</span>
            <input id="pm-new-name" type="text" class="field" value="Моя игра"/>
            <span class="pm-step">3 · Где создать</span>
            <div class="pm-dirbar"><span id="pm-new-dir" class="pm-dir"></span><button id="pm-new-browse" class="btn">Изменить…</button></div>
            <div id="pm-dest" class="pm-dest"></div>
            <button id="pm-create" class="btn primary pm-create">Создать проект</button>
            <div id="pm-new-error" class="pm-err"></div>
        </div>
    </div>
</div>

<!-- Рабочее пространство -->
<div id="app" class="hidden">
    <div id="topbar">
        <span id="tb-project" class="tb-btn">проект</span>
        <span id="tb-back" class="tb-btn icon"></span>
        <span id="tb-fwd" class="tb-btn icon"></span>
        <div id="tb-search"></div>
        <span id="tb-run" class="run-btn"></span>
        <span id="tb-stop" class="stop-btn disabled"></span>
    </div>

    <div id="main">
        <div id="rail">
            <div id="rail-project" class="rail-btn on"></div>
            <div id="rail-search" class="rail-btn"></div>
            <div id="rail-run" class="rail-btn"></div>
            <div id="rail-tools" class="rail-btn"></div>
        </div>

        <div id="sidebar">
            <div id="side-title" class="side-title">Проект</div>
            <div id="side-search" class="form hidden" style="padding: 0px 10px;"><input id="search-input" type="text" class="field" value=""/></div>
            <div id="side-body" class="side-body"></div>
        </div>

        <div id="center">
            <div id="tabs"></div>
            <div id="host">
                <div id="welcome" class="welcome"></div>
                <div id="code" class="hidden">
                    <div id="code-gutter"></div>
                    <div id="code-text">
                        <div id="code-under"></div>
                        <div id="code-lines"></div>
                        <div id="caret"></div>
                    </div>
                    <div id="code-vscroll"></div>
                    <span id="code-measure">MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM</span>
                    <div id="findbar" class="hidden">
                        <input id="find-input" type="text" class="field" value=""/>
                        <span id="find-count"></span>
                        <span id="find-prev" class="tb-btn icon"></span>
                        <span id="find-next" class="tb-btn icon"></span>
                        <span id="find-close" class="tb-btn icon"></span>
                    </div>
                </div>
                <div id="pane" class="pane hidden"></div>
            </div>
        </div>

        <div id="inspector">
            <div class="side-title">Inspector</div>
            <div id="insp-body" class="side-body"></div>
        </div>
    </div>

    <div id="bottom">
        <div id="bottom-tabs">
            <span id="bt-problems" class="btab on">Problems<span id="prob-badge" class="badge zero">0</span></span>
            <span id="bt-output" class="btab">Output</span>
            <span id="bt-console" class="btab">Console</span>
            <span class="grow"></span>
            <span id="bt-toggle" class="tb-btn icon"></span>
        </div>
        <div id="bottom-body"></div>
    </div>

    <div id="statusbar">
        <span id="st-project" class="st"></span>
        <span id="st-dirty" class="st"></span>
        <span id="st-runtime" class="st"></span>
        <span id="st-msg" class="st"></span>
        <span class="grow"></span>
        <span id="st-pos" class="st right"></span>
        <span id="st-lang" class="st right"></span>
    </div>

    <div id="palette" class="hidden">
        <input id="palette-input" type="text" value=""/>
        <div id="palette-list"></div>
    </div>
</div>
</body>
</rml>
