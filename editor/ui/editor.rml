<rml>
<head>
    <link type="text/rcss" href="editor.rcss"/>
    <link type="text/rcss" href="mascot.rcss"/>
    <title>Редактор Russiano2D</title>
</head>
<body>
<!-- Project Manager: без открытого проекта -->
<div id="pm">
    <div id="pm-top">
        <div id="pm-logo"></div>
        <div class="pm-brand">
            <span class="pm-name">Редактор Russiano2D</span>
            <span class="pm-tag">Откройте проект или начните новый</span>
        </div>
    </div>
    <div id="pm-body">
        <div id="pm-col-open">
            <div class="pm-sec-head"><span class="pm-sec-title">Недавние проекты</span><span id="pm-recent-count" class="pm-count"></span></div>
            <div id="pm-recent"></div>
            <button id="pm-open" class="btn primary pm-open">Открыть проект…</button>
            <span class="pm-hint">Выберите папку, в которой лежит project.json.</span>
            <div id="pm-error" class="pm-err"></div>
        </div>
        <div id="pm-col-new">
            <span class="pm-sec-title">Новый проект</span>
            <span class="pm-step">1 · Шаблон</span>
            <div id="pm-templates"></div>
            <span class="pm-step">2 · Название</span>
            <input id="pm-new-name" type="text" class="field" value="Моя игра"/>
            <span class="pm-step">3 · Где создать</span>
            <div class="pm-dirbar"><span id="pm-new-dir" class="pm-dir"></span><button id="pm-new-browse" class="btn">Изменить…</button></div>
            <div id="pm-dest" class="pm-dest"></div>
            <button id="pm-create" class="btn primary pm-create">Создать проект</button>
            <div id="pm-new-error" class="pm-err"></div>
        </div>
    </div>
</div>

<!-- Рабочее пространство -->
<div id="app" class="hidden">
    <div id="topbar">
        <span id="tb-project" class="tb-btn">проект</span>
        <span id="tb-back" class="tb-btn icon"></span>
        <span id="tb-fwd" class="tb-btn icon"></span>
        <div id="tb-search"></div>
        <span id="tb-run" class="run-btn"></span>
        <span id="tb-stop" class="stop-btn disabled"></span>
    </div>

    <div id="main">
        <div id="rail">
            <div id="rail-project" class="rail-btn on"></div>
            <div id="rail-search" class="rail-btn"></div>
            <div id="rail-snippets" class="rail-btn" title="Кирпичики"></div>
            <div id="rail-run" class="rail-btn"></div>
            <div id="rail-tools" class="rail-btn"></div>
        </div>

        <div id="sidebar">
            <div id="side-title" class="side-title">Проект</div>
            <div id="side-search" class="form hidden" style="padding: 0px 10px;"><input id="search-input" type="text" class="field" value=""/></div>
            <div id="side-body" class="side-body"></div>
        </div>

        <div id="center">
            <div id="tabs"></div>
            <div id="host">
                <div id="welcome" class="welcome"></div>
                <div id="code" class="hidden">
                    <div id="crumbs"></div>
                    <div id="code-gutter"></div>
                    <div id="code-text">
                        <div id="code-under"></div>
                        <div id="code-lines"></div>
                        <div id="ime-preview" class="hidden"></div>
                        <div id="carets-extra"></div>
                        <div id="caret"></div>
                    </div>
                    <div id="code-sticky" class="hidden"></div>
                    <div id="code-vscroll"></div>
                    <div id="code-map"><div id="code-map-lines"></div><div id="code-map-slider"></div></div>
                    <span id="code-measure">MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM</span>
                    <div id="findbar" class="hidden">
                        <div class="fb-row">
                            <input id="find-input" type="text" class="field" value=""/>
                            <span id="find-case" class="fb-opt" title="Учитывать регистр (Alt+C)">Aa</span>
                            <span id="find-word" class="fb-opt" title="Слово целиком (Alt+W)">ab</span>
                            <span id="find-regex" class="fb-opt" title="Регулярное выражение (Alt+R)">.*</span>
                            <span id="find-count"></span>
                            <span id="find-prev" class="tb-btn icon"></span>
                            <span id="find-next" class="tb-btn icon"></span>
                            <span id="find-close" class="tb-btn icon"></span>
                        </div>
                        <div id="replace-row" class="fb-row hidden">
                            <input id="replace-input" type="text" class="field" value=""/>
                            <span id="replace-one" class="fb-opt wide" title="Заменить (Enter)">Заменить</span>
                            <span id="replace-all" class="fb-opt wide" title="Заменить все (Cmd/Ctrl+Alt+Enter)">Все</span>
                        </div>
                    </div>
                    <div id="code-switch" class="hidden"><span id="cs-settings" class="cs-btn">Настройки</span><span id="cs-json" class="cs-btn on">JSON</span></div>
                    <div id="code-completion" class="hidden"></div>
                    <div id="api-hover" class="hidden"></div>
                    <div id="param-hint" class="hidden"></div>
                    <div id="code-menu" class="hidden"></div>
                </div>
                <div id="pane" class="pane hidden"></div>
            </div>
        </div>

        <div id="inspector">
            <div class="side-title">Инспектор</div>
            <div id="insp-body" class="side-body"></div>
        </div>

    </div>

    <div id="bottom">
        <div id="bottom-tabs">
            <span id="bt-problems" class="btab on">Проблемы<span id="prob-badge" class="badge zero">0</span></span>
            <span id="bt-output" class="btab">Вывод</span>
            <span id="bt-console" class="btab">Консоль</span>
            <span id="bt-graph" class="btab">Граф</span>
            <span id="bt-agent" class="btab"><span id="bt-agent-mc" class="mc-idle-0"></span>Агент</span>
            <span class="grow"></span>
            <span id="bt-toggle" class="tb-btn icon"></span>
        </div>
        <div id="bottom-body"></div>
        <div id="ag" class="hidden">
            <div id="ag-top">
                <span id="ag-state" class="ag-pill">Готов</span>
                <span id="ag-model-chip" class="ag-modelchip"></span>
                <span id="ag-mode" class="ag-modechip" title="Спрашивать подтверждение на каждую запись или разрешать всё сразу"></span>
                <span id="ag-usage" title="Токены за диалог (по данным API): отправлено · получено · из кэша"></span>
                <span class="grow"></span>
                <span id="ag-gear" class="tb-btn icon" title="Модели и настройки агента"></span>
                <span id="ag-undo" class="tb-btn icon" title="Откатить последнюю правку агента"></span>
                <span id="ag-clear" class="tb-btn icon" title="Новый диалог"></span>
            </div>
            <div id="ag-body">
                <div id="ag-col">
                    <div id="ag-log"></div>
                    <div id="ag-ask" class="hidden"></div>
                </div>
                <div id="ag-side">
                    <div id="ag-plan" class="hidden"></div>
                    <span id="mc-bubble" class="hidden"></span>
                    <span id="mc" class="mc-idle-0"></span>
                </div>
            </div>
            <div id="ag-compose">
                <textarea id="ag-input" class="ag-input" value=""></textarea>
                <div id="ag-compose-side">
                    <span id="ag-send" class="ag-send">Отправить</span>
                    <span id="ag-stop" class="ag-stop hidden">Стоп</span>
                    <span id="ag-hint">Ctrl/⌘ + Enter</span>
                </div>
            </div>
        </div>
        <div id="gp" class="hidden">
            <div id="gp-head">
                <div id="gp-crumbs"></div>
                <span id="gp-warn" class="gp-warn hidden"></span>
                <input id="gp-search" type="text" class="field" value=""/>
                <span id="gp-view-overview" class="gp-vbtn">Обзор</span>
                <span id="gp-view-world" class="gp-vbtn">Мир</span>
                <span id="gp-view-scenes" class="gp-vbtn">Сцены</span>
                <span id="gp-view-resources" class="gp-vbtn">Ресурсы</span>
                <span id="gp-backbtn" class="tb-btn icon"></span>
                <span id="gp-zoomout" class="tb-btn icon"></span>
                <span id="gp-zoomin" class="tb-btn icon"></span>
                <span id="gp-fit" class="tb-btn icon"></span>
                <span id="gp-code" class="tb-btn icon"></span>
                <span id="gp-reindex" class="tb-btn icon"></span>
                <span id="gp-status" class="gp-stat"></span>
                <span id="gp-fullbtn" class="tb-btn icon"></span>
            </div>
            <div id="gp-results" class="hidden"></div>
            <div id="gp-body">
                <div id="gp-canvas"></div>
                <div id="gp-empty" class="hidden"></div>
                <div id="gp-mini"></div>
            </div>
        </div>
    </div>

    <div id="statusbar">
        <span id="st-project" class="st"></span>
        <span id="st-dirty" class="st"></span>
        <span id="st-runtime" class="st"></span>
        <span id="st-msg" class="st"></span>
        <span class="grow"></span>
        <span id="st-pos" class="st right"></span>
        <span id="st-lang" class="st right"></span>
    </div>

    <div id="palette" class="hidden">
        <input id="palette-input" type="text" value=""/>
        <div id="palette-list"></div>
        <div id="palette-hint"></div>
    </div>

    <div id="close-confirm" class="hidden">
        <div class="close-scrim"></div>
        <div class="close-dialog" role="dialog" aria-modal="true" aria-labelledby="close-confirm-title">
            <span id="close-confirm-title" class="close-title">Сохранить изменения?</span>
            <span class="close-message">Документ <span id="close-confirm-path" class="close-path"></span> содержит несохранённые изменения.</span>
            <div class="close-actions">
                <button id="close-confirm-cancel" class="btn">Отмена</button>
                <span class="grow"></span>
                <button id="close-confirm-discard" class="btn danger">Закрыть без сохранения</button>
                <button id="close-confirm-save" class="btn primary">Сохранить</button>
            </div>
        </div>
    </div>

    <div id="file-conflict" class="hidden">
        <div class="close-scrim"></div>
        <div class="close-dialog" role="dialog" aria-modal="true" aria-labelledby="file-conflict-title">
            <span id="file-conflict-title" class="close-title">Файл изменён вне редактора</span>
            <span id="file-conflict-message" class="close-message"></span>
            <div class="close-actions">
                <button id="file-conflict-cancel" class="btn">Отмена</button>
                <span class="grow"></span>
                <button id="file-conflict-reload" class="btn">Загрузить с диска</button>
                <button id="file-conflict-overwrite" class="btn danger">Записать версию редактора</button>
            </div>
        </div>
    </div>
</div>
</body>
</rml>
