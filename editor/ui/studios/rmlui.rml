<rml>
<head>
<link type="text/rcss" href="kit.rcss"/><link type="text/rcss" href="rmlui.rcss"/>
<title>RmlUi</title>
</head>
<body>
<div class="st-root">
  <div class="st-bar">
    <span id="rm-file" class="st-label">—</span>
    <span class="st-sep"></span>
    <button id="rm-refresh" class="st-btn" title="Перестроить предпросмотр из текущих правок">Обновить превью</button>
    <button id="rm-validate" class="st-btn" title="r2d validate для документа и стилей (на черновиках)">Проверить</button>
    <span class="st-grow"></span>
    <span id="rm-dirty" class="st-dirty"></span>
    <span id="rm-status" class="st-pill ok">—</span>
  </div>
  <div class="st-main">
    <div class="st-left">
      <div class="st-scroll">
        <span class="st-h first">Элементы</span>
        <div id="rm-tree"></div>
      </div>
    </div>
    <div class="st-center">
      <div id="rm-view" class="st-canvas rm-view"></div>
      <div class="rm-src-bar"><span class="st-label">Исходник RML</span><span class="st-grow"></span><button id="rm-src-apply" class="st-btn">Применить исходник</button></div>
      <textarea id="rm-src" class="st-area rm-src"></textarea>
      <div class="st-hud">Клик в превью — выбрать элемент с id · дерево слева · Cmd/Ctrl+Z — отмена</div>
    </div>
    <div class="st-right">
      <div class="st-scroll">
        <div id="rm-props"></div>
        <span class="st-h">Стили</span>
        <div id="rm-sheets" class="st-btns"></div>
        <textarea id="rm-rcss" class="st-area rm-rcss"></textarea>
        <button id="rm-rcss-apply" class="st-btn wide">Применить стиль</button>
        <span class="st-h">Проверка</span>
        <div id="rm-diag"></div>
      </div>
    </div>
  </div>
</div>
</body>
</rml>
