/* Project Settings: форма поверх общего kit.rcss. */
.ps-root { background-color: #14161b; }
.ps-scroll { display: block; flex: 1 1 0; min-height: 0px; overflow-y: auto; }
.ps-body { display: block; max-width: 760px; padding: 18px 28px 40px 28px; }
.ps-h { display: block; margin: 20px 0px 8px 0px; font-size: 12px; letter-spacing: 1px; color: #8b93a3; }
.ps-h.first { margin-top: 0px; }
.ps-field { display: flex; flex-direction: row; align-items: center; margin: 5px 0px; }
.ps-field label { flex: 0 0 auto; width: 190px; font-size: 13px; color: #b8bec9; }
.ps-field input.st-in, .ps-field select.st-in { flex: 0 1 320px; width: 320px; height: 18px; padding: 4px 8px; font-size: 13px; }
.ps-def { display: inline-block; margin-left: 10px; font-size: 11px; color: #6b7280; }
.ps-note { display: block; margin: 6px 0px; font-size: 12px; color: #6b7280; white-space: normal; }
.ps-banner { display: block; padding: 12px 14px; margin-bottom: 14px; background-color: #2a2414; border-width: 1px; border-color: #6b5a22; border-radius: 6px; color: #e2b33c; font-size: 13px; white-space: normal; }
.ps-banner.err { background-color: #2a1618; border-color: #7f3434; color: #ffb4ab; }
.ps-card { display: block; padding: 10px 14px; margin-top: 6px; background-color: #1b1e24; border-width: 1px; border-color: #2a2f39; border-radius: 6px; }
.ps-line { display: block; margin: 3px 0px; font-size: 13px; color: #c9ced8; white-space: nowrap; overflow: hidden; }
.ps-line .muted { margin-left: 8px; }
.ps-diag { display: block; margin: 3px 0px; font-size: 12px; color: #e2b33c; white-space: normal; }
.ps-pill-ok { color: #4ad991; }
.ps-pill-warn { color: #e2b33c; }
