/* ---------------------------------------------------------------------------
   Общие стили студий Editor (палитра editor/ui/editor.rcss).
   Документ студии встраивается во вкладку (doc.place) и прозрачен там, где
   превью рисует кадр сцены (st-canvas). Любой overflow:auto — со стилями
   полос прокрутки ниже, иначе RmlUi схлопывает детей.
   --------------------------------------------------------------------------- */

body { font-family: Open Sans; font-size: 13px; color: #d7dce6; background-color: transparent; width: 100%; height: 100%; }

scrollbarvertical { width: 10px; margin: 0px; }
scrollbarvertical slidertrack { background-color: transparent; }
scrollbarvertical sliderbar { width: 6px; margin: 0px 2px; background-color: #3a404c; border-radius: 3px; }
scrollbarvertical sliderbar:hover { background-color: #4d5564; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { width: 0px; height: 0px; }
scrollbarhorizontal { height: 10px; margin: 0px; }
scrollbarhorizontal slidertrack { background-color: transparent; }
scrollbarhorizontal sliderbar { height: 6px; margin: 2px 0px; background-color: #3a404c; border-radius: 3px; }
scrollbarhorizontal sliderarrowdec, scrollbarhorizontal sliderarrowinc { width: 0px; height: 0px; }
scrollbarcorner { background-color: transparent; }

.st-root { display: flex; flex-direction: column; width: 100%; height: 100%; }
.st-hidden { display: none; }
/* Сильнее любого одноклассового правила студии (.at-strip { display: block } и т.п.). */
body .st-hidden, body div.st-hidden, body span.st-hidden { display: none; }
.st-grow { flex: 1 1 0; }

/* Тулбар */
.st-bar {
    display: flex; flex-direction: row; align-items: center; flex: 0 0 auto;
    padding: 5px 8px; background-color: #1b1e24; border-bottom: 1px #2a2f39;
}
.st-bar > * { flex: 0 0 auto; }
.st-bar .st-grow { flex: 1 1 0; }
.st-sep { display: inline-block; width: 1px; height: 20px; margin: 0px 8px; background-color: #2f3440; }
.st-label { color: #8b93a3; font-size: 12px; margin: 0px 6px 0px 2px; white-space: nowrap; }
.st-btn {
    display: inline-block; padding: 4px 9px; margin: 0px 3px 0px 0px; color: #d7dce6; font-size: 12px; cursor: pointer;
    white-space: nowrap; background-color: #262a33; border-width: 1px; border-color: #343a46; border-radius: 4px;
}
.st-btn:hover { background-color: #30353f; border-color: #4a5160; }
.st-btn.on { color: #ffffff; border-color: #3b82f6; background-color: #1f3a5f; }
.st-btn.off { color: #5b6270; }
.st-btn.primary { background-color: #238636; border-color: #2ea043; color: #ffffff; }
.st-btn.primary:hover { background-color: #2ea043; }
.st-btn.danger:hover { border-color: #c93c3c; color: #ff9d88; }
.st-btn.wide { display: block; width: 100%; margin: 4px 0px; box-sizing: border-box; text-align: center; }
.st-pill {
    display: inline-block; padding: 2px 9px; margin-left: 4px; font-size: 12px; color: #c3c9d4; white-space: nowrap;
    background-color: #14161b; border-width: 1px; border-color: #2f3440; border-radius: 10px;
}
.st-pill.ok { color: #4ad991; }
.st-pill.err { color: #f14c4c; border-color: #6b2b2b; }
.st-dirty { color: #e2b33c; margin-right: 6px; white-space: nowrap; }

/* Тело: колонки */
.st-main { display: flex; flex-direction: row; flex: 1 1 0; min-height: 0px; }
.st-left {
    display: flex; flex-direction: column; width: 240px; flex: 0 0 240px; min-height: 0px;
    background-color: #1b1e24; border-right: 1px #2a2f39;
}
.st-right {
    display: flex; flex-direction: column; width: 290px; flex: 0 0 290px; min-height: 0px;
    background-color: #1b1e24; border-left: 1px #2a2f39;
}
.st-center { display: flex; flex-direction: column; flex: 1 1 0; min-width: 0px; background-color: transparent; }
.st-scroll { display: block; flex: 1 1 0; min-height: 0px; overflow-y: auto; padding: 6px 10px 10px 10px; }
.st-canvas { display: block; position: relative; flex: 1 1 0; min-height: 0px; overflow: hidden; background-color: transparent; }
.st-overlay { display: block; position: absolute; left: 0px; top: 0px; right: 0px; bottom: 0px; overflow: hidden; }
.st-hud { display: block; flex: 0 0 auto; padding: 3px 10px; font-size: 12px; color: #8b93a3; background-color: #14161b; white-space: nowrap; overflow: hidden; }
.st-foot { display: block; flex: 0 0 auto; padding: 6px 10px; background-color: #1b1e24; border-top: 1px #2a2f39; }

/* Секции, поля, списки */
.st-title { display: block; color: #e6e9ef; font-size: 14px; margin: 2px 0px 6px 0px; }
.st-h { display: block; margin: 12px 0px 5px 0px; font-size: 11px; letter-spacing: 1px; color: #8b93a3; }
.st-h.first { margin-top: 2px; }
.st-field { display: flex; flex-direction: row; align-items: center; margin: 3px 0px; }
.st-field label { flex: 0 0 auto; width: 72px; color: #8b93a3; font-size: 12px; }
.st-field .st-btn { margin-left: 4px; }
input.st-in, select.st-in {
    display: block; flex: 1 1 0; width: 40px; min-width: 30px; height: 16px; padding: 3px 6px; margin-right: 3px;
    color: #e6e9ef; background-color: #14161b; border-width: 1px; border-color: #2f3440; border-radius: 4px; cursor: text;
}
input.st-in:focus { border-color: #3b82f6; }
textarea.st-area {
    display: block; width: 100%; box-sizing: border-box; margin: 3px 0px; padding: 5px 6px; font-size: 12px;
    color: #e6e9ef; background-color: #14161b; border-width: 1px; border-color: #2f3440; border-radius: 4px;
}
.st-row { display: block; padding: 3px 8px; font-size: 12px; color: #c9ced8; cursor: pointer; border-radius: 3px; white-space: nowrap; overflow: hidden; }
.st-row:hover { background-color: #23272f; }
.st-row.sel { background-color: #1f3a5f; color: #ffffff; }
.st-row .st-sub { color: #8b93a3; margin-left: 6px; }
.st-row.off { color: #5b6270; }
.st-btns { display: flex; flex-direction: row; flex-wrap: wrap; }
.st-btns .st-btn { margin-bottom: 3px; }
.st-note { display: block; font-size: 11px; color: #6b7280; margin: 4px 0px; }
.st-empty { display: block; padding: 6px 2px; color: #6b7280; font-size: 12px; }
.st-diag { display: block; font-size: 12px; margin: 2px 0px; }
.st-diag.error { color: #f14c4c; }
.st-diag.warning { color: #e2b33c; }
