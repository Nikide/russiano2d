.st-bar { flex-wrap: wrap; }
.st-bar .st-title { margin: 0px 8px 0px 0px; }
.st-left { width: 205px; flex-basis: 205px; }
.st-right { width: 280px; flex-basis: 280px; }
.aw-bottom { display: block; flex: 0 0 auto; max-height: 150px; overflow-y: auto; background-color: #1b1e24; }
.aw-source { display: flex; flex-direction: column; flex: 0 0 220px; padding: 8px; }
.aw-source .st-area { flex: 1 1 0; min-height: 0px; }
.aw-table { display: block; padding: 18px; }
.aw-card { display: block; padding: 14px; margin-bottom: 8px; background-color: #20252d; border: 1px #343a46; border-radius: 6px; }
.aw-card.on { border-color: #3b82f6; }
.aw-card .st-title { color: #ffffff; }
.aw-palette { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
.aw-tile { width: 38px; height: 38px; margin: 2px; padding: 2px; background-color: #101318; border: 1px #343a46; cursor: pointer; }
.aw-tile.on { border-color: #56a8ff; background-color: #214361; }
.aw-tile img { width: 32px; height: 32px; }
.aw-diagnostics { color: #f8a398; font-size: 11px; margin-top: 12px; }
.st-field { flex-wrap: wrap; }
.st-field label { width: 88px; }
.st-field textarea { height: 64px; }
.aw-meter { height: 10px; margin: 8px 0px; background-color: #101318; }
.aw-meter-fill { height: 100%; background-color: #39ad7c; }
.aw-keys { font-size: 18px; color: #98c8ff; margin: 8px 0px; }
.aw-preview-text { padding: 24px; }
