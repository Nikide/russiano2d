.st-bar { flex-wrap: wrap; }
.st-bar .st-title { margin: 0px 8px 0px 0px; }
.st-left { width: 205px; flex-basis: 205px; }
.st-right { width: 280px; flex-basis: 280px; }
.aw-bottom { display: block; flex: 0 0 auto; max-height: 150px; overflow-y: auto; background-color: #1b1e24; }
.aw-source { display: flex; flex-direction: column; flex: 0 0 220px; padding: 8px; }
.aw-source .st-area { flex: 1 1 0; min-height: 0px; }
.aw-table { display: block; padding: 18px; }
.aw-card { display: block; padding: 14px; margin-bottom: 8px; background-color: #20252d; border: 1px #343a46; border-radius: 6px; }
.aw-card.on { border-color: #3b82f6; }
.aw-card .st-title { color: #ffffff; }
.aw-palette { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
.aw-tile { width: 38px; height: 38px; margin: 2px; padding: 2px; background-color: #101318; border: 1px #343a46; cursor: pointer; }
.aw-tile.on { border-color: #56a8ff; background-color: #214361; }
.aw-tile img { width: 32px; height: 32px; }
.aw-diagnostics { color: #f8a398; font-size: 11px; margin-top: 12px; }
.st-field { flex-wrap: wrap; }
.st-field label { width: 88px; }
.st-field textarea { height: 64px; }
.aw-meter { height: 10px; margin: 8px 0px; background-color: #101318; }
.aw-meter-fill { height: 100%; background-color: #39ad7c; }
.aw-keys { font-size: 18px; color: #98c8ff; margin: 8px 0px; }
.aw-preview-text { padding: 24px; }
/* Particles: рампы снизу, код использования слева */
.aw-bottom.pt-bottom { max-height: 220px; }
.pt-ramps { display: block; }
.pt-ramps .st-bar { flex-wrap: wrap; }
.pt-graph { display: block; position: relative; height: 150px; margin: 6px 10px 8px 10px; overflow: hidden; background-color: #0e1117; border: 1px #2a2f39; border-radius: 6px; }
.pt-axis { position: absolute; color: #7b87a0; font-size: 10px; }
input.st-in.pt-small { flex: 0 0 auto; width: 56px; }
.pt-code { display: block; white-space: pre-wrap; font-family: Roboto Mono; font-size: 11px; color: #9fb4d0; padding: 6px; background-color: #14161b; border-radius: 4px; overflow: hidden; word-break: break-word; }
/* Parallax: спрайты слоя и картинки проекта */
.aw-bottom.px-bottom-host { max-height: 230px; }
.px-bottom { display: flex; flex-direction: row; padding: 4px 10px 8px 10px; }
.px-col { display: block; flex: 1 1 0; min-width: 0px; padding-right: 10px; }
.px-list { display: block; max-height: 170px; overflow-y: auto; }
input.st-in.px-n { flex: 0 0 auto; width: 36px; margin-left: 4px; }
.px-img { height: 28px; }
.px-img img { width: 24px; height: 24px; margin-right: 6px; vertical-align: middle; }
/* Fonts: подписи образца и факты стиля */
.aw-bottom.ft-bottom-host { max-height: 120px; }
.ft-bottom { display: block; padding: 6px 10px; }
.ft-facts { display: block; font-size: 12px; color: #c9ced8; margin-top: 4px; }
.ft-facts .st-label { margin-left: 12px; }
.ft-tag { position: absolute; left: 24px; font-size: 11px; color: #6b7280; }
.ft-tag.on { color: #ff9d88; }
/* Audio: микшер шин поверх холста и транспорт звуков */
.au-mixer { display: flex; flex-direction: row; overflow-x: auto; padding: 10px 10px 0px 10px; }
.au-strip { display: flex; flex-direction: column; align-items: center; flex: 0 0 auto; width: 84px; margin-right: 8px; padding: 6px 4px; background-color: #1b1e24; border: 1px #2a2f39; border-radius: 6px; cursor: pointer; }
.au-strip.on { border-color: #3b82f6; }
.au-name { font-size: 12px; color: #e6e9ef; white-space: nowrap; overflow: hidden; }
.au-parent { font-size: 10px; color: #6b7280; margin-bottom: 4px; }
.au-meter { display: block; position: relative; width: 14px; height: 90px; background-color: #0e1117; border: 1px #2a2f39; border-radius: 3px; }
.au-fill { display: block; position: absolute; left: 0px; right: 0px; bottom: 0px; background-color: #39ad7c; border-radius: 2px; }
.au-val { font-size: 10px; color: #9aa3b2; margin: 3px 0px; white-space: nowrap; }
.au-row { display: flex; flex-direction: row; }
.au-row .st-btn { padding: 2px 7px; }
.au-fx { font-size: 10px; color: #e2b33c; height: 12px; }
.aw-bottom.au-bottom-host { max-height: 200px; }
.au-bottom { display: block; }
.au-sounds { display: block; padding: 2px 10px 8px 10px; }
.au-tx { float: right; }
.au-tx .st-btn { padding: 1px 7px; }
/* Input: тестер действий и клавиши выбранного действия */
.in-grid { display: block; padding: 12px 16px; overflow-y: auto; height: 100%; }
.in-tile { display: inline-block; width: 180px; margin: 0px 8px 8px 0px; padding: 8px 10px; background-color: #1b1e24; border: 1px #2a2f39; border-radius: 6px; cursor: pointer; vertical-align: top; }
.in-tile.sel { border-color: #3b82f6; }
.in-tile.lit { background-color: #1f5f3a; border-color: #4ad991; }
.in-name { display: block; font-size: 13px; color: #e6e9ef; margin-bottom: 4px; }
.in-keys { display: block; }
.in-key { display: inline-block; font-size: 11px; color: #c9ced8; padding: 1px 6px; margin: 0px 3px 3px 0px; background-color: #262a33; border-radius: 3px; }
.in-key.bad, .in-chip.bad { color: #ffb4a8; background-color: #4a2424; }
.in-key.unknown { color: #e2b33c; }
.in-conflict { display: block; font-size: 12px; color: #ffb4a8; }
.aw-bottom.in-bottom-host { max-height: 80px; }
.in-bottom { display: block; padding: 6px 10px; }
.in-chip { display: inline-block; padding: 2px 2px 2px 8px; margin-right: 4px; font-size: 12px; background-color: #262a33; border-radius: 4px; }
.in-chip .st-btn { padding: 0px 5px; margin: 0px 0px 0px 4px; }
input.st-in.in-new { display: inline-block; width: 110px; flex: 0 0 auto; }
