/* Вкладка «Модели»: список провайдеров агента. */
.md-root { background-color: #14161b; }
.md-scroll { display: block; flex: 1 1 0; min-height: 0px; overflow-y: auto; }
.md-body { display: block; max-width: 820px; padding: 26px 32px 48px 32px; }
.md-title { display: block; font-size: 22px; color: #f0f2f6; margin-bottom: 6px; }
.md-sub { display: block; font-size: 13px; color: #8b93a3; margin-bottom: 18px; white-space: normal; }
.md-h { display: block; margin: 24px 0px 8px 0px; font-size: 12px; letter-spacing: 1px; color: #8b93a3; }
.md-row { display: flex; flex-direction: row; align-items: center; margin-top: 8px; padding: 14px 16px; background-color: #1b1e24; border-width: 1px; border-color: #2a2f39; border-radius: 10px; }
.md-row.on { border-color: #2f5a94; background-color: #1a2740; }
.md-row.open { border-bottom-left-radius: 0px; border-bottom-right-radius: 0px; }
.md-name { display: inline-block; font-size: 15px; color: #f0f2f6; }
.md-badge { display: inline-block; margin-left: 8px; padding: 1px 7px; border-width: 1px; border-color: #3a4150; border-radius: 5px; font-size: 11px; color: #9aa2b1; }
.md-dot { display: inline-block; width: 8px; height: 8px; margin-left: 10px; border-radius: 4px; background-color: #3a4150; }
.md-dot.ok { background-color: #3fb950; }
.md-meta { display: block; font-size: 12px; color: #7d8594; margin-top: 3px; }
.md-main { display: block; flex: 1 1 0; min-width: 0px; }
.md-active { display: inline-block; margin-right: 10px; padding: 3px 10px; border-radius: 10px; font-size: 11px; color: #cfe2ff; background-color: #1f3a5f; }
.md-card { display: block; padding: 6px 16px 16px 16px; background-color: #181b21; border-width: 1px; border-color: #2a2f39; border-top-width: 0px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; }
.md-label { display: block; margin: 12px 0px 5px 0px; font-size: 12px; color: #9aa2b1; }
.md-hint { display: block; margin-top: 4px; font-size: 11px; color: #667085; white-space: normal; }
.md-in { display: block; width: 100%; box-sizing: border-box; padding: 8px 10px; color: #e6e9ef; background-color: #101216; border-width: 1px; border-color: #2f3440; border-radius: 6px; font-size: 13px; cursor: text; }
.md-in:focus { border-color: #3b82f6; }
.md-actions { display: flex; flex-direction: row; align-items: center; margin-top: 14px; }
.md-actions > * { margin-right: 8px; }
.md-result { display: inline-block; margin-left: 6px; font-size: 12px; color: #8b93a3; }
.md-result.ok { color: #3fb950; }
.md-result.err { color: #f87171; }
.md-chips { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
.md-chip { display: inline-block; margin: 0px 6px 6px 0px; padding: 3px 10px; border-radius: 11px; font-size: 12px; color: #b8bec9; background-color: #20242c; border-width: 1px; border-color: #2d323d; cursor: pointer; }
.md-chip:hover { color: #ffffff; border-color: #4a5160; }
.md-chip.on { color: #ffffff; background-color: #1f3a5f; border-color: #2f5a94; }
.md-add { display: block; margin-top: 8px; padding: 12px 16px; border-width: 1px; border-color: #3a4150; border-radius: 10px; font-size: 13px; color: #9aa2b1; cursor: pointer; }
.md-add:hover { border-color: #4a5160; color: #e6e9ef; }
.md-note { display: block; margin-top: 18px; font-size: 12px; color: #667085; white-space: normal; }
.md-two { display: flex; flex-direction: row; }
.md-two > div { flex: 1 1 0; margin-right: 12px; }
