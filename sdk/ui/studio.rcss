/* ---------------------------------------------------------------------------
   Общие стили студий (Sprite Studio, Animation Studio).

   Важно: у body НЕТ фона. Область просмотра прозрачна — сквозь неё видна сцена
   движка, в которой настоящий рантайм рисует текстуру и анимацию. Все
   остальные панели непрозрачны.
   --------------------------------------------------------------------------- */

body {
    font-family: Open Sans;
    font-size: 14px;
    color: #dbe4f0;
    width: 100%;
    height: 100%;
}

.studio { display: flex; flex-direction: column; width: 100%; height: 100%; }

.bar {
    display: block;
    padding: 6px 12px;
    background-color: #0a0f19;
    border-color: #1f2b40;
    border-width: 0px;
}
.bar.top { border-bottom-width: 1px; }
.bar.bottom { border-top-width: 1px; }
.bar > * { margin-right: 8px; }
.title { color: #7fd1ff; font-size: 16px; margin-right: 16px; }
.dirty { color: #ffd27f; }
.sub { color: #8393a8; }

.body-row { display: flex; flex-direction: row; flex: 1 1 0; min-height: 0; }

.side {
    display: block;
    width: 260px;
    padding: 8px;
    overflow-y: auto;
    background-color: #0b111c;
}
.side.left { border-right-width: 1px; border-color: #1f2b40; }
.side.right { border-left-width: 1px; border-color: #1f2b40; width: 300px; }

.center { display: block; flex: 1 1 0; min-width: 0; position: relative; }

/* Окно просмотра: прозрачное, сквозь него видна сцена. */
.viewport { position: absolute; left: 0px; top: 0px; right: 0px; bottom: 0px; overflow: hidden; }
.overlay { position: absolute; left: 0px; top: 0px; right: 0px; bottom: 0px; overflow: hidden; }

.fr {
    position: absolute;
    border-width: 1px;
    border-color: rgba(127, 209, 255, 170);
}
.fr.sel { border-color: #ffd27f; background-color: rgba(255, 210, 127, 40); }
.fr.hot { border-color: #a8e6a1; }
.fr-label {
    position: absolute;
    left: 1px; top: 1px;
    font-size: 11px;
    color: #cfe9ff;
    background-color: rgba(8, 12, 20, 200);
    padding: 0px 3px;
}
.pivot {
    position: absolute;
    width: 9px; height: 9px;
    border-width: 2px;
    border-color: #ff6b9d;
    border-radius: 6px;
    background-color: rgba(255, 107, 157, 90);
}
.drag { position: absolute; border-width: 1px; border-color: #a8e6a1; background-color: rgba(168, 230, 161, 50); }
.hud-text {
    position: absolute; left: 8px; bottom: 6px;
    padding: 2px 8px; color: #cfe0f5; font-size: 12px;
    background-color: rgba(8, 12, 20, 210); border-radius: 4px;
}

h4 { display: block; margin: 10px 0 4px 0; color: #8fb4de; font-size: 14px; }
.hint { display: block; color: #7b8da6; font-size: 12px; margin: 4px 0; }
.empty { display: block; color: #6c7b90; padding: 6px 4px; }

.list { display: block; max-height: 300px; overflow-y: auto; background-color: #0d1522; border-radius: 6px; border-width: 1px; border-color: #1b283d; }
.list.grow { max-height: 420px; }
.row { display: block; padding: 4px 8px; }
.row:hover { background-color: #172540; }
.row.sel { background-color: #223a60; }
.row-name { color: #eaf2ff; margin-right: 8px; }
.row-dir { color: #6f84a2; font-size: 12px; }

.field-row { display: flex; flex-direction: row; margin: 3px 0; }
.field-row > label { width: 78px; color: #8393a8; padding-top: 6px; }
input.field {
    display: block; flex: 1 1 0; min-width: 40px; height: 26px; padding: 3px 8px;
    color: #eef4ff; background-color: #0a111d;
    border-width: 1px; border-color: #2b3c58; border-radius: 4px;
}
input.field:focus { border-color: #7fd1ff; }
.pair { display: flex; flex-direction: row; flex: 1 1 0; }
.pair > input.field { margin-right: 4px; }

.btn {
    display: inline-block; padding: 5px 12px; color: #dbe7f7;
    background-color: #1a2a44; border-radius: 5px; border-width: 1px; border-color: #2b4366;
}
.btn:hover { background-color: #23395c; }
.btn.primary { background-color: #2a5fa0; border-color: #4a86cc; color: #ffffff; }
.btn.primary:hover { background-color: #3571bb; }
.btn.on { background-color: #2f6b4a; border-color: #4aa377; color: #ffffff; }
.btn.small { padding: 2px 9px; font-size: 12px; }
.btn.off { color: #5f7088; }

.diag-strip { display: block; height: 96px; overflow-y: auto; padding: 3px 12px; background-color: #0a0f19; border-top-width: 1px; border-color: #1f2b40; }
.diag { display: block; padding: 2px 0; }
.diag-sev { display: inline-block; width: 64px; font-size: 11px; }
.diag-code { color: #dbe4f0; margin-right: 10px; font-size: 13px; }
.diag-asset { color: #6f84a2; font-size: 12px; }
.diag-msg { display: block; margin-left: 64px; color: #aab9cf; font-size: 12px; }
.diag-err .diag-sev { color: #ff8f8f; }
.diag-warn .diag-sev { color: #ffd27f; }
.diag-info .diag-sev { color: #7fd1ff; }

.strip-cell { display: inline-block; margin: 2px; padding: 3px 7px; background-color: #152036; border-radius: 4px; color: #b9c8de; }
.strip-cell.cur { background-color: #2a5fa0; color: #ffffff; }
.kv { display: block; padding: 1px 0; color: #9fb2cc; font-size: 13px; }
