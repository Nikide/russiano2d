<rml><head><link type="text/rcss" href="theme.rcss"/><link type="text/rcss" href="studio.rcss"/><link type="text/rcss" href="vn_maker.rcss"/><title>Visual Novel Maker</title></head><body>
<div class="studio">
  <div class="bar top">
    <button id="vnm-back" class="btn small">К SDK</button>
    <span class="title">Visual Novel Maker</span>
    <button id="vnm-save" class="btn small">Сохранить</button>
    <button id="vnm-undo" class="btn small">Отменить</button>
    <button id="vnm-redo" class="btn small">Повторить</button>
    <button id="vnm-validate" class="btn small">Проверить</button>
    <button id="vnm-play" class="btn small">Запустить</button>
    <button id="vnm-from" class="btn small">С этой строки</button>
    <button id="vnm-stop" class="btn small">Остановить</button>
    <button id="vnm-source-mode" class="btn small">Исходник</button>
    <button id="vnm-graph" class="btn small">Граф</button>
  </div>
  <div class="body-row vnm-row">
    <div class="vnm-side vnm-left">
      <h4>Сцены</h4>
      <div id="vnm-scenes" class="vnm-list"></div>
      <div class="field-row"><input id="vnm-new-path" class="field" type="text" value="story/new.scene"/><button id="vnm-new" class="btn small">Новая</button></div>
      <h4>Метки</h4>
      <div id="vnm-labels" class="vnm-list"></div>
      <h4>Персонажи</h4>
      <div id="vnm-speakers" class="vnm-list"></div>
      <textarea id="vnm-speakers-json" class="area" style="height:90px;"></textarea>
      <button id="vnm-speakers-save" class="btn small">Сохранить персонажей</button>
      <h4>Персонаж</h4>
      <input id="vnm-ch-id" class="field" type="text" placeholder="идентификатор персонажа"/>
      <input id="vnm-ch-name" class="field" type="text" placeholder="имя на экране"/>
      <input id="vnm-ch-slot" class="field" type="text" placeholder="слева / центр / справа"/>
      <input id="vnm-ch-blip" class="field" type="text" placeholder="звук реплики"/>
      <input id="vnm-ch-expr" class="field" type="text" placeholder="эмоции: neutral, happy"/>
      <button id="vnm-ch-save" class="btn small">Сохранить персонажа</button>
      <h4>Поиск</h4>
      <input id="vnm-search" class="field" type="text" placeholder="текст, метка, ассет…"/>
      <button id="vnm-find" class="btn small">Найти</button>
      <div id="vnm-results" class="vnm-list"></div>
    </div>
    <div class="vnm-main">
      <div class="bar">
        <span id="vnm-scene-name" class="vnm-scene-name">—</span>
        <button id="vnm-add" class="btn small">+ Команда</button>
        <button id="vnm-del" class="btn small">Удалить</button>
        <button id="vnm-up" class="btn small">↑</button>
        <button id="vnm-down" class="btn small">↓</button>
        <button id="vnm-dup" class="btn small">Дубль</button>
      </div>
      <div id="vnm-commands" class="vnm-commands"></div><div id="vnm-graph-view" class="vnm-commands" style="display:none;"></div>
      <textarea id="vnm-source-buffer" class="vnm-source" style="display:none;"></textarea>
    </div>
    <div class="vnm-side vnm-right">
      <h4>Инспектор</h4>
      <div id="vnm-inspector">
        <div id="vnm-insp-empty" class="hint">Выберите команду.</div>
        <div id="vnm-insp-fields" style="display:none;">
          <div class="field-row"><label>Тип</label><input id="vnm-f-kind" class="field" type="text"/></div>
          <div class="field-row"><label>Спикер</label><input id="vnm-f-speaker" class="field" type="text"/></div>
          <div class="field-row"><label>Эмоция</label><input id="vnm-f-expr" class="field" type="text"/></div>
          <div class="field-row"><label>Слот</label><input id="vnm-f-slot" class="field" type="text"/></div>
          <div class="field-row"><label>Текст</label></div>
          <textarea id="vnm-f-text" class="area" style="height:90px;"></textarea>
          <div class="field-row"><label>Голос</label><input id="vnm-f-voice" class="field" type="text"/><button id="vnm-pick-voice" class="btn small">…</button></div>
          <div class="field-row"><label>Ассет</label><input id="vnm-f-asset" class="field" type="text"/><button id="vnm-pick-asset" class="btn small">…</button></div>
          <div class="field-row"><label>Переход</label><input id="vnm-f-goto" class="field" type="text"/></div>
          <div class="field-row"><label>Сырой текст</label></div>
          <textarea id="vnm-f-raw" class="area" style="height:70px;"></textarea>
          <button id="vnm-apply" class="btn primary">Применить</button>
        </div>
      </div>
      <h4>Ассеты</h4>
      <input id="vnm-asset-query" class="field" type="text" placeholder="фильтр…"/>
      <button id="vnm-asset-find" class="btn small">Найти ассеты</button>
      <div id="vnm-assets" class="vnm-list"></div>
      <h4>Темы</h4><div id="vnm-themes" class="vnm-list"></div>
      <button id="vnm-theme-open" class="btn small">Открыть RML</button>
      <button id="vnm-theme-validate" class="btn small">Проверить тему</button>
      <div id="vnm-theme-info" class="hint"></div>
      <textarea id="vnm-theme-rcss" class="area" style="height:90px;"></textarea>
      <button id="vnm-theme-save" class="btn small">Сохранить RCSS</button>
      <h4>Тема / i18n</h4><div id="vnm-env" class="hint"></div><div id="vnm-i18n" class="vnm-list"></div>
      <textarea id="vnm-i18n-json" class="area" style="height:100px;"></textarea>
      <button id="vnm-i18n-save" class="btn small">Сохранить i18n</button>
      <h4>Проблемы</h4>
      <div id="vnm-diag" class="vnm-diag"></div>
      <div id="vnm-state" class="hint"></div>
    </div>
  </div>
</div>
</body></rml>
