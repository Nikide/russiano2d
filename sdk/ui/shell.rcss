/* ---------------------------------------------------------------------------
   Russiano2D SDK — оболочка. Весь интерфейс — RmlUi.
   Размеры в процентах и flex: окно SDK можно менять мышью.
   --------------------------------------------------------------------------- */

body {
    font-family: Open Sans;
    font-size: 15px;
    color: #dbe4f0;
    width: 100%;
    height: 100%;
    background-color: #0e1420;
}

#app {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
}

/* --- Верхняя полоса ------------------------------------------------------ */
#topbar {
    display: block;
    height: 38px;
    padding: 9px 16px 0 16px;
    background-color: #0a0f19;
    border-bottom-width: 1px;
    border-color: #1f2b40;
}

#brand { color: #7fd1ff; font-size: 17px; margin-right: 24px; }
#project-badge { color: #93a4bb; margin-right: 24px; }
#status { color: #a8e6a1; }
#status.busy { color: #ffd27f; }
#status.fail { color: #ff8f8f; }

/* --- Основная часть ------------------------------------------------------ */
#main {
    display: flex;
    flex-direction: row;
    flex: 1 1 0;
    min-height: 0;
}

#nav {
    display: block;
    width: 200px;
    padding: 14px 10px;
    background-color: #0b111c;
    border-right-width: 1px;
    border-color: #1f2b40;
}

.nav-btn {
    display: block;
    width: 100%;
    margin-bottom: 6px;
    padding: 9px 12px;
    text-align: left;
    color: #c4d0e2;
    background-color: #131c2c;
    border-radius: 6px;
}
.nav-btn:hover { background-color: #1b2840; }
.nav-btn.on { color: #ffffff; background-color: #26446c; }

#nav-version { margin-top: 20px; color: #5f7088; font-size: 12px; }

#content {
    display: block;
    flex: 1 1 0;
    min-width: 0;
    padding: 14px 20px;
    overflow-y: auto;
}

.view { display: block; }
.view.hidden { display: none; }

h2 { display: block; font-size: 22px; color: #eaf2ff; margin-bottom: 10px; }
h3 { display: block; font-size: 16px; color: #8fb4de; margin: 16px 0 6px 0; }
.hint { display: block; color: #8393a8; margin-bottom: 8px; }
.empty { display: block; color: #6c7b90; padding: 8px 4px; }

.panel {
    display: block;
    padding: 12px;
    background-color: #111a29;
    border-radius: 8px;
    border-width: 1px;
    border-color: #1f2b40;
}

.form-row { display: flex; flex-direction: row; margin: 6px 0; }
.form-row > * { margin-right: 8px; }

/* --- Поля и кнопки ------------------------------------------------------- */
input.field {
    display: block;
    flex: 1 1 0;
    min-width: 120px;
    height: 32px;
    padding: 5px 10px;
    color: #eef4ff;
    background-color: #0a111d;
    border-width: 1px;
    border-color: #2b3c58;
    border-radius: 5px;
}
input.field:focus { border-color: #7fd1ff; }

.btn {
    display: block;
    padding: 6px 14px;
    color: #dbe7f7;
    background-color: #1a2a44;
    border-radius: 5px;
    border-width: 1px;
    border-color: #2b4366;
}
.btn:hover { background-color: #23395c; }
.btn.primary { background-color: #2a5fa0; border-color: #4a86cc; color: #ffffff; }
.btn.primary:hover { background-color: #3571bb; }
.btn.small { display: inline-block; padding: 2px 10px; font-size: 13px; }

/* --- Списки -------------------------------------------------------------- */
.list {
    display: block;
    max-height: 260px;
    overflow-y: auto;
    background-color: #0d1522;
    border-radius: 6px;
    border-width: 1px;
    border-color: #1b283d;
}
.list.tall { max-height: 420px; }
.list.short { max-height: 160px; }

.row { display: block; padding: 5px 10px; }
.row:hover { background-color: #172540; }
.row.sel { background-color: #223a60; }
.row-name { color: #eaf2ff; margin-right: 12px; }
.row-dir { color: #6f84a2; margin-right: 12px; font-size: 13px; }
.row-type { color: #8fd8ff; margin-right: 12px; font-size: 13px; }
.row-size { color: #7a8aa0; margin-right: 12px; font-size: 13px; }
.row-tool { color: #a8e6a1; font-size: 13px; }

.chip {
    display: inline-block;
    margin: 4px 6px 4px 0;
    padding: 2px 10px;
    color: #b9c8de;
    background-color: #152036;
    border-radius: 10px;
}
.chip:hover { background-color: #1d2e4d; }
.chip.on { color: #ffffff; background-color: #2a5fa0; }

/* --- Карточки инструментов ------------------------------------------------ */
.card {
    display: block;
    margin: 8px;
    padding: 10px 14px;
    background-color: #111b2d;
    border-radius: 8px;
    border-width: 1px;
    border-color: #223454;
}
.card.invalid { border-color: #8a3b3b; background-color: #1e1519; }
.card-head { display: block; margin-bottom: 4px; }
.card-name { font-size: 17px; color: #f1f6ff; margin-right: 10px; }
.tag { margin-right: 6px; padding: 1px 8px; font-size: 12px; color: #9ec2ee; background-color: #172944; border-radius: 8px; }
.tag-bad { color: #ffb0b0; background-color: #4a2020; }
.card-desc { display: block; color: #c4d0e2; margin-bottom: 4px; }
.card-meta { display: block; color: #6f84a2; font-size: 12px; }
.card-note { display: block; color: #ffb0b0; font-size: 13px; margin-top: 3px; }
.card-actions { display: block; margin-top: 8px; }

/* --- Сводка проекта -------------------------------------------------------- */
.kv { display: block; padding: 2px 0; }
.k { display: inline-block; width: 120px; color: #7b8da6; }
.v { color: #e3ecfa; }

/* --- Журнал ---------------------------------------------------------------- */
.log {
    display: block;
    max-height: 220px;
    overflow-y: auto;
    padding: 8px 10px;
    color: #b8c6da;
    font-size: 13px;
    white-space: pre-wrap;
    background-color: #090e17;
    border-radius: 6px;
    border-width: 1px;
    border-color: #1b283d;
}
.log.tall-log { max-height: 360px; margin-top: 8px; }
#run-status { display: block; margin-top: 8px; color: #9fb2cc; }

/* --- Панель диагностик ------------------------------------------------------ */
#diag {
    display: block;
    height: 190px;
    background-color: #0a0f19;
    border-top-width: 1px;
    border-color: #1f2b40;
}
#diag-head { display: block; padding: 6px 14px; background-color: #0d1422; }
#diag-title { color: #eaf2ff; margin-right: 18px; }
#diag-counts { color: #8393a8; margin-right: 18px; }
#diag-list { display: block; height: 140px; overflow-y: auto; padding: 4px 14px; }

.diag { display: block; padding: 3px 0; }
.diag-sev { display: inline-block; width: 70px; font-size: 12px; }
.diag-code { color: #dbe4f0; margin-right: 12px; }
.diag-asset { color: #6f84a2; font-size: 13px; }
.diag-msg { display: block; margin-left: 70px; color: #aab9cf; font-size: 13px; }
.diag-err .diag-sev { color: #ff8f8f; }
.diag-warn .diag-sev { color: #ffd27f; }
.diag-info .diag-sev { color: #7fd1ff; }
