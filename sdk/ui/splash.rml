<rml><head>
<link type="text/rcss" href="theme.rcss"/>
<link type="text/rcss" href="splash.rcss"/>
<title>Russiano2D SDK</title>
</head><body>
<div class="splash">
  <img id="splash-img" class="splash-img" src="../assets/splash.jpg"/>
  <div class="splash-shade"></div>
  <div class="splash-panel">
    <div class="splash-kicker">R2D · SDK</div>
    <div id="splash-title" class="splash-title">КОМПЛЕКТ ДЛЯ РАЗРАБОТКИ (SDK)</div>
    <div id="splash-stage" class="splash-stage">подготовка…</div>
    <div id="splash-track" class="splash-track"><div id="splash-bar" class="splash-bar"><div id="splash-fill" class="splash-fill"></div></div></div>
    <div class="splash-meta"><span id="splash-percent">0%</span><span id="splash-version"></span></div>
  </div>
</div>
</body></rml>
